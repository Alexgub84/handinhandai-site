---
import CinematicLayout from '@layouts/CinematicLayout.astro';
import ScrollHero from '@components/scroll-hero/ScrollHero.astro';
import { languages, type Lang } from '@i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };

const meta = lang === 'he'
  ? {
      title: 'Hand in Hand AI — תפסיקו להריץ תוכנה, תתחילו לנהל עסק',
      description: 'צוות AI מותאם אישית לעסק שלכם — מחובר לכל המערכות, עובד מסביב לשעון, מטפל בעבודה התפעולית כדי שתוכלו להתמקד במה שחשוב.',
    }
  : {
      title: 'Hand in Hand AI — Stop running software. Start running your business.',
      description: 'Custom AI workforce built for your business. We design, build, and operate AI agents that handle your operational work — so your team can focus on what matters.',
    };
---

<CinematicLayout 
  lang={lang} 
  title={meta.title} 
  description={meta.description}
  ogImage="/og/home/og.jpg"
>
  <ScrollHero lang={lang} />
</CinematicLayout>
