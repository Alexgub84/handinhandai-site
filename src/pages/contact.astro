---
import Layout from '@layouts/Layout.astro';
import ContactForm from '@components/ContactForm.astro';
import { useTranslations } from '@i18n/utils';
import { defaultLang } from '@i18n/ui';

const lang = defaultLang;
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('contact.title')}>
  <section class="py-12 sm:py-16 md:py-24 bg-gradient-to-br from-blue-50 to-white min-h-[80vh] flex items-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="text-center mb-8 sm:mb-12">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-3 sm:mb-4">
          {t('contact.title')}
        </h1>
        <p class="text-base sm:text-lg text-gray-600">
          {t('contact.subtitle')}
        </p>
      </div>

      <ContactForm lang={lang} />
    </div>
  </section>
</Layout>
