---
import FitnessLayout from '@layouts/FitnessLayout.astro';
import { siteContact } from '@/data/site-contact';
import { useTranslations } from '@i18n/utils';
import { defaultLang } from '@i18n/ui';
import WhatsAppMock from '@components/whatsapp-mock/WhatsAppMock';
import { churnRecoveryMessages } from '@components/whatsapp-mock/scenarios/churn-recovery';

const lang = defaultLang;
const t = useTranslations(lang);

const pageDescription =
  'סוכן AI שנבנה במיוחד לרשת שלכם. עונה ללקוחות בוואטסאפ בכל סניף, קובע שיעורים ומזהה מתאמנים בסיכון נטישה. תואם מדיניות מטא 2026.';

const contactPath = '/contact';
const waPhone = siteContact.phoneTel.replace('+', '');
const waMessage = encodeURIComponent(
  'היי אלכס, ראיתי את הדף לרשתות כושר ורוצה לקבוע שיחת היכרות.'
);
const waLink = `https://wa.me/${waPhone}?text=${waMessage}`;

const waIconPath = "M19.05 4.91A10 10 0 0 0 4.6 18.96L3 23l4.16-1.55A10 10 0 1 0 19.05 4.91Zm-7 15.42a8.32 8.32 0 0 1-4.24-1.16l-.3-.18-2.46.92.92-2.4-.2-.31a8.34 8.34 0 1 1 6.28 3.13Zm4.57-6.24c-.25-.13-1.48-.73-1.71-.81s-.4-.13-.56.13-.65.81-.79.97-.29.2-.54.07a6.85 6.85 0 0 1-2.01-1.24 7.55 7.55 0 0 1-1.4-1.74c-.15-.25 0-.39.11-.51.11-.11.25-.29.37-.43a1.7 1.7 0 0 0 .25-.41.46.46 0 0 0 0-.43c-.07-.13-.56-1.36-.77-1.86s-.41-.43-.56-.43h-.48a.91.91 0 0 0-.66.31 2.78 2.78 0 0 0-.87 2.07 4.83 4.83 0 0 0 1 2.55 11.06 11.06 0 0 0 4.23 3.74 14.32 14.32 0 0 0 1.41.52 3.39 3.39 0 0 0 1.56.1 2.55 2.55 0 0 0 1.67-1.18 2.07 2.07 0 0 0 .14-1.18c-.06-.13-.23-.2-.48-.33Z";
---

<FitnessLayout
  lang={lang}
  title={t('fitness-chain.page.title')}
  description={pageDescription}
  ogImage="/og/fitness-chain/og.jpg"
>
  <div class="fs-page" dir="rtl" lang="he">

    <!-- TopBar -->
    <div class="fs-topbar">
      <div class="fs-brand">
        <span class="fs-brand-mark">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18">
            <path d={waIconPath} />
          </svg>
        </span>
        <span>{t('fitness-chain.topbar.brand')}</span>
      </div>
      <a class="fs-topbar-cta" href={waLink}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="14" height="14">
          <path d={waIconPath} />
        </svg>
        <span>{t('fitness-chain.topbar.cta')}</span>
      </a>
    </div>

    <!-- Hero -->
    <section class="fs-section fs-hero">
      <div class="fs-hero-stage">
        <div class="fs-hero-image" style={`background-image: url(/fitness-chain/hero.png)`}></div>
        <div class="fs-hero-copy">
          <p class="fs-eyebrow">{t('fitness-chain.hero.eyebrow')}</p>
          <h1 class="fs-h1" style="white-space: pre-line">{t('fitness-chain.hero.title')}</h1>
          <p class="fs-hero-tagline">{t('fitness-chain.hero.tagline')}</p>
          <p class="fs-lede">{t('fitness-chain.hero.lede')}</p>
          <div class="fs-hero-cta-row">
            <a class="fs-btn fs-btn-primary" href={contactPath}>
              <span>{t('fitness-chain.hero.cta')}</span>
            </a>
            <a class="fs-btn fs-btn-ghost" href="#demo">
              <span>צפו בהדגמה ↓</span>
            </a>
          </div>
          <p class="fs-trust" style="display:block; margin-top:12px">{t('fitness-chain.hero.trust')}</p>
        </div>
      </div>
      <div class="fs-hero-mock-row" id="demo">
        <div class="fs-mock-slot">
          <WhatsAppMock
            client:load
            messages={churnRecoveryMessages}
            headerName="רשת כושר · סניף ת״א"
            avatarUrl="/scenarios/avatar.png"
          />
        </div>
        <div class="fs-hero-mock-aside">
          <p class="fs-eyebrow">{t('fitness-chain.hero.mock.aside.eyebrow')}</p>
          <h3 class="fs-h3">{t('fitness-chain.hero.mock.aside.title')}</h3>
          <p class="fs-muted">{t('fitness-chain.hero.mock.aside.body')}</p>
        </div>
      </div>
    </section>

    <!-- Problem -->
    <section class="fs-section fs-section-band">
      <p class="fs-eyebrow">{t('fitness-chain.problems.eyebrow')}</p>
      <h2 class="fs-h2" style="max-width: 28ch">{t('fitness-chain.problems.title')}</h2>
      <ul class="fs-pain-list">
        <li>{t('fitness-chain.problems.pain1')}</li>
        <li>{t('fitness-chain.problems.pain2')}</li>
        <li>{t('fitness-chain.problems.pain3')}</li>
        <li>{t('fitness-chain.problems.pain4')}</li>
      </ul>
    </section>

    <!-- What the agent does -->
    <section class="fs-section">
      <p class="fs-eyebrow">{t('fitness-chain.agent.eyebrow')}</p>
      <h2 class="fs-h2">{t('fitness-chain.agent.title')}</h2>
      <p class="fs-lede" style="max-width: 50ch">{t('fitness-chain.agent.lede')}</p>

      <div class="fs-agent-grid">

        <!-- Card 1: Lead response -->
        <div class="fs-agent-card">
          <h3 class="fs-h3">{t('fitness-chain.agent.card1.title')}</h3>
          <p class="fs-muted" style="margin:0 0 16px">{t('fitness-chain.agent.card1.body')}</p>
          <div class="fs-mini-wa" dir="rtl">
            <div class="fs-mini-wa-msg in">
              <span class="fs-mini-wa-time">23:14</span>היי, אני מחפש מקום להתאמן באזור רמת גן
            </div>
            <div class="fs-mini-wa-msg out">
              <span class="fs-mini-wa-time">23:14</span>שלום! יש לנו סניף ברמת גן ברחוב ביאליק 47. רוצה לקבוע שיעור ניסיון?
            </div>
            <div class="fs-mini-wa-msg in">
              <span class="fs-mini-wa-time">23:15</span>כן
            </div>
          </div>
        </div>

        <!-- Card 2: Multi-branch booking -->
        <div class="fs-agent-card">
          <h3 class="fs-h3">{t('fitness-chain.agent.card2.title')}</h3>
          <p class="fs-muted" style="margin:0 0 16px">{t('fitness-chain.agent.card2.body')}</p>
          <div class="fs-mini-wa" dir="rtl">
            <div class="fs-mini-wa-msg in">
              <span class="fs-mini-wa-time">08:23</span>יש פילאטיס היום בהרצליה?
            </div>
            <div class="fs-mini-wa-msg out">
              <span class="fs-mini-wa-time">08:23</span>כן, 18:00 או 20:00. גם ברעננה יש ב-19:00. מה מתאים?
            </div>
            <div class="fs-mini-wa-msg in">
              <span class="fs-mini-wa-time">08:24</span>20:00 בהרצליה
            </div>
            <div class="fs-mini-wa-msg out">
              <span class="fs-mini-wa-time">08:24</span>רשמתי ✓
            </div>
          </div>
        </div>

        <!-- Card 3: Churn detection -->
        <div class="fs-agent-card">
          <h3 class="fs-h3">{t('fitness-chain.agent.card3.title')}</h3>
          <p class="fs-muted" style="margin:0 0 16px">{t('fitness-chain.agent.card3.body')}</p>
          <div class="fs-mini-wa" dir="rtl">
            <div class="fs-mini-wa-msg out">
              <span class="fs-mini-wa-time">14:32</span>היי שירה, שמנו לב שלא ראינו אותך כבר 3 שבועות. הכל בסדר?
            </div>
            <div class="fs-mini-wa-msg in">
              <span class="fs-mini-wa-time">14:45</span>סליחה, נסחפתי בעבודה
            </div>
            <div class="fs-mini-wa-msg out">
              <span class="fs-mini-wa-time">14:46</span>שיעור חזרה עלינו? בחרי יום השבוע ❤️
            </div>
          </div>
        </div>

        <!-- Card 4: Escalation with context -->
        <div class="fs-agent-card">
          <h3 class="fs-h3">{t('fitness-chain.agent.card4.title')}</h3>
          <p class="fs-muted" style="margin:0 0 16px">{t('fitness-chain.agent.card4.body')}</p>
          <div class="fs-mini-wa" dir="rtl">
            <div class="fs-mini-wa-msg in">
              <span class="fs-mini-wa-time">11:02</span>אני צריך לבטל את המנוי בגלל בעיה רפואית
            </div>
            <div class="fs-mini-wa-msg out">
              <span class="fs-mini-wa-time">11:02</span>מבין. העברתי לעמית מהצוות, הוא יחזור אליך תוך שעה עם כל הפרטים.
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- How It Works -->
    <section class="fs-section">
      <p class="fs-eyebrow">{t('fitness-chain.how.eyebrow')}</p>
      <h2 class="fs-h2" style="max-width: 32ch">{t('fitness-chain.how.title')}</h2>
      <ol class="fs-step-list">
        <li>
          <span class="fs-step-num">1</span>
          <h3 class="fs-h3">{t('fitness-chain.how.step1.title')}</h3>
          <p class="fs-muted" style="margin:0">{t('fitness-chain.how.step1.body')}</p>
        </li>
        <li>
          <span class="fs-step-num">2</span>
          <h3 class="fs-h3">{t('fitness-chain.how.step2.title')}</h3>
          <p class="fs-muted" style="margin:0">{t('fitness-chain.how.step2.body')}</p>
        </li>
        <li>
          <span class="fs-step-num">3</span>
          <h3 class="fs-h3">{t('fitness-chain.how.step3.title')}</h3>
          <p class="fs-muted" style="margin:0">{t('fitness-chain.how.step3.body')}</p>
        </li>
        <li>
          <span class="fs-step-num">4</span>
          <h3 class="fs-h3">{t('fitness-chain.how.step4.title')}</h3>
          <p class="fs-muted" style="margin:0">{t('fitness-chain.how.step4.body')}</p>
        </li>
      </ol>
    </section>

    <!-- Comparison -->
    <section class="fs-section fs-section-band">
      <p class="fs-eyebrow">{t('fitness-chain.compare.eyebrow')}</p>
      <h2 class="fs-h2">{t('fitness-chain.compare.title')}</h2>
      <p class="fs-lede" style="max-width: 56ch">{t('fitness-chain.compare.intro')}</p>
      <div class="fs-compare-wrap">
        <table class="fs-compare-table">
          <thead>
            <tr>
              <th>{t('fitness-chain.compare.col1')}</th>
              <th>{t('fitness-chain.compare.col2')}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>{t('fitness-chain.compare.row1.shelf')}</td>
              <td>{t('fitness-chain.compare.row1.custom')}</td>
            </tr>
            <tr>
              <td>{t('fitness-chain.compare.row2.shelf')}</td>
              <td>{t('fitness-chain.compare.row2.custom')}</td>
            </tr>
            <tr>
              <td>{t('fitness-chain.compare.row3.shelf')}</td>
              <td>{t('fitness-chain.compare.row3.custom')}</td>
            </tr>
            <tr>
              <td>{t('fitness-chain.compare.row4.shelf')}</td>
              <td>{t('fitness-chain.compare.row4.custom')}</td>
            </tr>
            <tr>
              <td>{t('fitness-chain.compare.row5.shelf')}</td>
              <td>{t('fitness-chain.compare.row5.custom')}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ -->
    <section class="fs-section">
      <p class="fs-eyebrow">{t('fitness-chain.faq.eyebrow')}</p>
      <h2 class="fs-h2">{t('fitness-chain.faq.title')}</h2>
      <div class="fs-faq">
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness-chain.faq.q1')}</span><span>+</span>
          </button>
          <div class="fs-faq-a"><p style="margin:0">{t('fitness-chain.faq.a1')}</p></div>
        </div>
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness-chain.faq.q2')}</span><span>+</span>
          </button>
          <div class="fs-faq-a"><p style="margin:0">{t('fitness-chain.faq.a2')}</p></div>
        </div>
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness-chain.faq.q3')}</span><span>+</span>
          </button>
          <div class="fs-faq-a"><p style="margin:0">{t('fitness-chain.faq.a3')}</p></div>
        </div>
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness-chain.faq.q4')}</span><span>+</span>
          </button>
          <div class="fs-faq-a"><p style="margin:0">{t('fitness-chain.faq.a4')}</p></div>
        </div>
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness-chain.faq.q5')}</span><span>+</span>
          </button>
          <div class="fs-faq-a"><p style="margin:0">{t('fitness-chain.faq.a5')}</p></div>
        </div>
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness-chain.faq.q6')}</span><span>+</span>
          </button>
          <div class="fs-faq-a"><p style="margin:0">{t('fitness-chain.faq.a6')}</p></div>
        </div>
      </div>
    </section>

    <!-- Why I build this -->
    <section class="fs-section">
      <div class="fs-why-block">
        <p class="fs-eyebrow">{t('fitness-chain.why.eyebrow')}</p>
        <h2 class="fs-h2">{t('fitness-chain.why.title')}</h2>
        <p class="fs-muted" style="max-width: 56ch; font-size: 18px; line-height: 1.7">{t('fitness-chain.why.body')}</p>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="fs-section fs-section-dark">
      <h2 class="fs-h2">{t('fitness-chain.finalcta.title')}</h2>
      <p class="fs-lede" style="max-width: 44ch">{t('fitness-chain.finalcta.lede')}</p>
      <a class="fs-btn fs-btn-primary" href={contactPath}>
        <span>{t('fitness-chain.finalcta.cta')}</span>
      </a>
    </section>

    <!-- Footer -->
    <footer class="fs-footer">
      <div>{t('fitness-chain.footer.copyright')}</div>
      <div style="display:flex; gap:18px">
        <a href={`tel:${siteContact.phoneTel}`}>{siteContact.phoneDisplay}</a>
        <a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
      </div>
    </footer>

  </div>
</FitnessLayout>

<script>
  document.querySelectorAll<HTMLElement>('.fs-faq-item').forEach((item) => {
    item.querySelector('.fs-faq-q')?.addEventListener('click', () => {
      const isOpen = item.dataset.open === 'true';
      document.querySelectorAll<HTMLElement>('.fs-faq-item').forEach((el) => {
        el.dataset.open = 'false';
      });
      item.dataset.open = isOpen ? 'false' : 'true';
    });
  });
</script>
