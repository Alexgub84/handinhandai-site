---
/* /articles — the מדריכים list page. Work order `.claude/work-orders/guides-flow.md`.
   Replaces the plain `<h1>` + underlined link list with the approved "dossier"
   design (owner-chosen after seeing 3 variants; local/guides-list/README.md),
   staged in the design system as local/design-system/patterns/guides-list.html.
   A vertical case list: each guide is a docket row with a stamped seal
   (alternating brand green / deep orange --orb, same token as the homepage
   portrait disc), a dashed spine line, a cluster tab, the publish date as a
   case-open stamp, and "זמן עיון" (review time) instead of a generic
   reading-time label. New CSS lives in `src/styles/home/articles-list.css`,
   prefixed `.dk-` (dossier), ported from the specimen — `app.css` / `tailwind.css`
   stay frozen.

   Renders through the homepage design system (HomeDocumentShell +
   PageHeader), same as `/app-publishing` and `/`, so this reads as a bigger
   sibling of the homepage guides band, not a different site — instead of the
   old generic Layout.astro + Tailwind `global.css`.

   Content comes entirely from `getGuidesIndex()` (src/data/articles.ts):
   publishing a guide adds a row with no change here. The build's own test
   fixture never appears (same `FIXTURE_SLUG` gate the homepage band uses). */
import "@styles/home/articles-list.css";
import HomeDocumentShell from "@/components/home/HomeDocumentShell.astro";
import PageHeader from "@/components/home/PageHeader.astro";
import LucideIcon from "@/components/home/LucideIcon.astro";
import { getCollection } from "astro:content";
import { getGuidesIndex } from "@/data/articles";
import { CLUSTER_HEADINGS } from "@/data/guides-format";
import { resolveSite } from "@/data/organization-schema";
import { isArticlesIndexNoindexed } from "@/lib/articles-index-noindex.mjs";

const guides = await getGuidesIndex();

// Zero published articles is a real, expected state right after #98 (the
// seed stays draft) — the index must not invite search engines to a page
// with nothing published on it yet. A listed draft (preview builds only)
// doesn't change this: the page is still noindexed until something is
// actually published. astro.config.mjs reads this same condition (off disk,
// not off the collection — see src/lib/articles-index-noindex.mjs) to keep
// this page out of the sitemap at the same time (#160). Unfiltered: the
// noindex decision needs every article's draft flag, not just the ones
// this build is allowed to show.
const allArticles = await getCollection("articles");
const noindex = isArticlesIndexNoindexed(allArticles.map((a) => a.data.draft));

const title = "מדריכים | HandInHandAI";
const description = "מדריכים מעשיים, מבוססי ניסיון תפעולי בפועל — החלטות שחוזרות כמעט בכל פרויקט.";
const canonicalPath = "/articles";
const ogImagePath = "/og/default.jpg";

const site = resolveSite(Astro.site);

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}); // DD/MM/YYYY -> reformatted to DD.MM.YYYY below, matching the specimen.
const formatCaseDate = (d: Date) => dateFormatter.format(d).replace(/\//g, ".");

const caseTag =
  guides.length === 1
    ? "תיק עבודה · מדריך פתוח אחד"
    : `תיק עבודה · ${String(guides.length).padStart(2, "0")} מדריכים פתוחים`;

const itemListLd =
  guides.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        itemListElement: guides.map((g, i) => ({
          "@type": "ListItem",
          position: i + 1,
          url: new URL(`/articles/${g.slug}/`, site).href,
          name: g.title,
        })),
      }
    : null;
---

<HomeDocumentShell
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogImagePath={ogImagePath}
  jsonLd={itemListLd ? [itemListLd] : []}
  noindex={noindex}
>
  <PageHeader slot="head-extra" waMessage="היי אלכס, הגעתי מדף המדריכים ואשמח לעוד פרטים" />

  <section class="dk" id="guides-index" dir="rtl" aria-labelledby="dk-title">
    <div class="cs-wrap">
      <div class="dk-head">
        <span class="dk-tag">{caseTag}</span>
        <h1 class="cs-title" id="dk-title">מדריכים<br /><em>שנכתבו כדי שתחליטו מהר יותר.</em></h1>
        <p class="cs-sub">מדריכים מעשיים, מבוססי ניסיון תפעולי בפועל.</p>
      </div>

      {guides.length === 0 ? (
        <p class="dk-empty">בקרוב — המדריכים הראשונים בדרך.</p>
      ) : (
        <ul class="dk-list">
          {guides.map((g, i) => (
            <li class="dk-row" style={`--i:${i}`}>
              <a class="dk-link" href={`/articles/${g.slug}/`}>
                <span class="dk-seal" dir="ltr">{String(i + 1).padStart(2, "0")}</span>
                <div class="dk-main">
                  <div class="dk-stat-row">
                    <span class="dk-tab">{CLUSTER_HEADINGS[g.cluster] ?? g.cluster}</span>
                    <span class="dk-date">נפתח {formatCaseDate(g.publishedAt)}</span>
                    {g.draft && <span class="dk-draft">טיוטה — לא פורסם</span>}
                  </div>
                  <h3 class="dk-q">{g.title}</h3>
                  <p class="dk-a">{g.description}</p>
                  <div class="dk-foot">
                    <span class="dk-review">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                      זמן עיון: {g.reviewMinutes} דק'
                    </span>
                    <span class="dk-go">
                      פתיחת התיק
                      <LucideIcon name="arrow-left" strokeWidth={2.5} />
                    </span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</HomeDocumentShell>
