---
import FitnessLayout from '@layouts/FitnessLayout.astro';
import { siteContact } from '@/data/site-contact';
import { useTranslations } from '@i18n/utils';
import { defaultLang } from '@i18n/ui';
import WhatsAppMock from '@components/whatsapp-mock/WhatsAppMock';
import { trialBookingMessages } from '@components/whatsapp-mock/scenarios/trial-booking';
import { waitlistMessages } from '@components/whatsapp-mock/scenarios/waitlist';
import { followupMessages } from '@components/whatsapp-mock/scenarios/followup';

const lang = defaultLang;
const t = useTranslations(lang);

const pageDescription = t('fitness.hero.lede');
const waPhone = siteContact.phoneTel.replace('+', '');
const waMessage = encodeURIComponent('היי אלכס, ראיתי את הדף עם הבוטים לסטודיואים, רוצה לדבר.');
const waLink = `https://wa.me/${waPhone}?text=${waMessage}`;
---

<FitnessLayout
  lang={lang}
  title={t('fitness.page.title')}
  description={pageDescription}
  ogImage="/og/fitness/og.jpg"
>
  <div class="fs-page" dir="rtl" lang="he">

    <!-- TopBar -->
    <div class="fs-topbar">
      <div class="fs-brand">
        <span class="fs-brand-mark">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18">
            <path d="M19.05 4.91A10 10 0 0 0 4.6 18.96L3 23l4.16-1.55A10 10 0 1 0 19.05 4.91Zm-7 15.42a8.32 8.32 0 0 1-4.24-1.16l-.3-.18-2.46.92.92-2.4-.2-.31a8.34 8.34 0 1 1 6.28 3.13Zm4.57-6.24c-.25-.13-1.48-.73-1.71-.81s-.4-.13-.56.13-.65.81-.79.97-.29.2-.54.07a6.85 6.85 0 0 1-2.01-1.24 7.55 7.55 0 0 1-1.4-1.74c-.15-.25 0-.39.11-.51.11-.11.25-.29.37-.43a1.7 1.7 0 0 0 .25-.41.46.46 0 0 0 0-.43c-.07-.13-.56-1.36-.77-1.86s-.41-.43-.56-.43h-.48a.91.91 0 0 0-.66.31 2.78 2.78 0 0 0-.87 2.07 4.83 4.83 0 0 0 1 2.55 11.06 11.06 0 0 0 4.23 3.74 14.32 14.32 0 0 0 1.41.52 3.39 3.39 0 0 0 1.56.1 2.55 2.55 0 0 0 1.67-1.18 2.07 2.07 0 0 0 .14-1.18c-.06-.13-.23-.2-.48-.33Z" />
          </svg>
        </span>
        <span>{t('fitness.topbar.brand')}</span>
      </div>
      <a class="fs-topbar-cta" href={waLink}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="14" height="14">
          <path d="M19.05 4.91A10 10 0 0 0 4.6 18.96L3 23l4.16-1.55A10 10 0 1 0 19.05 4.91Zm-7 15.42a8.32 8.32 0 0 1-4.24-1.16l-.3-.18-2.46.92.92-2.4-.2-.31a8.34 8.34 0 1 1 6.28 3.13Zm4.57-6.24c-.25-.13-1.48-.73-1.71-.81s-.4-.13-.56.13-.65.81-.79.97-.29.2-.54.07a6.85 6.85 0 0 1-2.01-1.24 7.55 7.55 0 0 1-1.4-1.74c-.15-.25 0-.39.11-.51.11-.11.25-.29.37-.43a1.7 1.7 0 0 0 .25-.41.46.46 0 0 0 0-.43c-.07-.13-.56-1.36-.77-1.86s-.41-.43-.56-.43h-.48a.91.91 0 0 0-.66.31 2.78 2.78 0 0 0-.87 2.07 4.83 4.83 0 0 0 1 2.55 11.06 11.06 0 0 0 4.23 3.74 14.32 14.32 0 0 0 1.41.52 3.39 3.39 0 0 0 1.56.1 2.55 2.55 0 0 0 1.67-1.18 2.07 2.07 0 0 0 .14-1.18c-.06-.13-.23-.2-.48-.33Z" />
        </svg>
        <span>{t('fitness.topbar.cta')}</span>
      </a>
    </div>

    <!-- Hero -->
    <section class="fs-section fs-hero">
      <div class="fs-hero-stage">
        <div class="fs-hero-image" style={`background-image: url(/fitness/hero.png)`}>
          <span class="fs-hero-image-tag">{t('fitness.hero.image.tag')}</span>
        </div>
        <div class="fs-hero-copy">
          <p class="fs-eyebrow">{t('fitness.hero.eyebrow')}</p>
          <h1 class="fs-h1" style="white-space: pre-line">{t('fitness.hero.title')}</h1>
          <p class="fs-lede">{t('fitness.hero.lede')}</p>
          <div>
            <a class="fs-btn fs-btn-primary" href={waLink}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20">
                <path d="M19.05 4.91A10 10 0 0 0 4.6 18.96L3 23l4.16-1.55A10 10 0 1 0 19.05 4.91Zm-7 15.42a8.32 8.32 0 0 1-4.24-1.16l-.3-.18-2.46.92.92-2.4-.2-.31a8.34 8.34 0 1 1 6.28 3.13Zm4.57-6.24c-.25-.13-1.48-.73-1.71-.81s-.4-.13-.56.13-.65.81-.79.97-.29.2-.54.07a6.85 6.85 0 0 1-2.01-1.24 7.55 7.55 0 0 1-1.4-1.74c-.15-.25 0-.39.11-.51.11-.11.25-.29.37-.43a1.7 1.7 0 0 0 .25-.41.46.46 0 0 0 0-.43c-.07-.13-.56-1.36-.77-1.86s-.41-.43-.56-.43h-.48a.91.91 0 0 0-.66.31 2.78 2.78 0 0 0-.87 2.07 4.83 4.83 0 0 0 1 2.55 11.06 11.06 0 0 0 4.23 3.74 14.32 14.32 0 0 0 1.41.52 3.39 3.39 0 0 0 1.56.1 2.55 2.55 0 0 0 1.67-1.18 2.07 2.07 0 0 0 .14-1.18c-.06-.13-.23-.2-.48-.33Z" />
              </svg>
              <span>{t('fitness.hero.cta')}</span>
            </a>
            <span class="fs-trust">{t('fitness.hero.trust')}</span>
          </div>
        </div>
      </div>
      <div class="fs-hero-mock-row">
        <div class="fs-mock-slot">
          <WhatsAppMock
            client:load
            messages={trialBookingMessages}
            headerName="סטודיו פראנה · יוגי"
            avatarUrl="/scenarios/avatar.png"
          />
        </div>
        <div class="fs-hero-mock-aside">
          <p class="fs-eyebrow">{t('fitness.hero.mock.aside.eyebrow')}</p>
          <h3 class="fs-h3">{t('fitness.hero.mock.aside.title')}</h3>
          <p class="fs-muted">{t('fitness.hero.mock.aside.body')}</p>
        </div>
      </div>
    </section>

    <!-- AI Bot Explainer -->
    <section class="fs-section fs-section-band">
      <h2 class="fs-h2">{t('fitness.explainer.title')}</h2>
      <ul class="fs-check-list">
        <li>✓ {t('fitness.explainer.item1')}</li>
        <li>✓ {t('fitness.explainer.item2')}</li>
        <li>✓ {t('fitness.explainer.item3')}</li>
      </ul>
      <p class="fs-caption">{t('fitness.explainer.closing')}</p>
    </section>

    <!-- Problem -->
    <section class="fs-section fs-section-band">
      <p class="fs-eyebrow">{t('fitness.problem.eyebrow')}</p>
      <h2 class="fs-h2">{t('fitness.problem.title')}</h2>
      <ul class="fs-pain-list">
        <li>{t('fitness.problem.pain1')}</li>
        <li>{t('fitness.problem.pain2')}</li>
        <li>{t('fitness.problem.pain3')}</li>
      </ul>
    </section>

    <!-- Scenario 2: Gym -->
    <section class="fs-section">
      <div class="fs-scenario-grid">
        <div class="fs-mock-slot">
          <WhatsAppMock
            client:visible
            messages={waitlistMessages}
            headerName="פאוור הוס · ארנולד"
            avatarUrl="/scenarios/avatar.png"
          />
        </div>
        <div>
          <p class="fs-eyebrow">{t('fitness.scenario2.label')}</p>
          <h2 class="fs-h2">{t('fitness.scenario2.heading')}</h2>
          <p class="fs-caption">{t('fitness.scenario2.desc')}</p>
        </div>
      </div>
    </section>

    <!-- Mid CTA -->
    <section class="fs-section fs-section-dark">
      <h2 class="fs-h2">{t('fitness.midcta.title')}</h2>
      <p class="fs-lede" style="max-width: 42ch">{t('fitness.midcta.lede')}</p>
      <a class="fs-btn fs-btn-primary" href={waLink}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20">
          <path d="M19.05 4.91A10 10 0 0 0 4.6 18.96L3 23l4.16-1.55A10 10 0 1 0 19.05 4.91Zm-7 15.42a8.32 8.32 0 0 1-4.24-1.16l-.3-.18-2.46.92.92-2.4-.2-.31a8.34 8.34 0 1 1 6.28 3.13Zm4.57-6.24c-.25-.13-1.48-.73-1.71-.81s-.4-.13-.56.13-.65.81-.79.97-.29.2-.54.07a6.85 6.85 0 0 1-2.01-1.24 7.55 7.55 0 0 1-1.4-1.74c-.15-.25 0-.39.11-.51.11-.11.25-.29.37-.43a1.7 1.7 0 0 0 .25-.41.46.46 0 0 0 0-.43c-.07-.13-.56-1.36-.77-1.86s-.41-.43-.56-.43h-.48a.91.91 0 0 0-.66.31 2.78 2.78 0 0 0-.87 2.07 4.83 4.83 0 0 0 1 2.55 11.06 11.06 0 0 0 4.23 3.74 14.32 14.32 0 0 0 1.41.52 3.39 3.39 0 0 0 1.56.1 2.55 2.55 0 0 0 1.67-1.18 2.07 2.07 0 0 0 .14-1.18c-.06-.13-.23-.2-.48-.33Z" />
        </svg>
        <span>{t('fitness.midcta.cta')}</span>
      </a>
    </section>

    <!-- Scenario 3: MMA -->
    <section class="fs-section">
      <div class="fs-scenario-grid is-flipped">
        <div>
          <p class="fs-eyebrow">{t('fitness.scenario3.label')}</p>
          <h2 class="fs-h2">{t('fitness.scenario3.heading')}</h2>
          <p class="fs-caption">{t('fitness.scenario3.desc')}</p>
          <div class="fs-alert-card">
            <span class="fs-alert-icon">🔔</span>
            <div>
              <p class="fs-alert-title">התראה</p>
              <p class="fs-alert-body">נועה (ניסיון אתמול), פידבק חשוב, חזור אליה</p>
            </div>
          </div>
        </div>
        <div class="fs-mock-slot">
          <WhatsAppMock
            client:visible
            messages={followupMessages}
            headerName="אקדמיית הלוחמים · ברוס"
            avatarUrl="/scenarios/avatar.png"
          />
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="fs-section fs-section-band">
      <p class="fs-eyebrow">{t('fitness.how.eyebrow')}</p>
      <h2 class="fs-h2">{t('fitness.how.title')}</h2>
      <ol class="fs-step-list">
        <li>
          <span class="fs-step-num">1</span>
          <h3 class="fs-h3">{t('fitness.step1.title')}</h3>
          <p class="fs-muted" style="margin:0">{t('fitness.step1.body')}</p>
        </li>
        <li>
          <span class="fs-step-num">2</span>
          <h3 class="fs-h3">{t('fitness.step2.title')}</h3>
          <p class="fs-muted" style="margin:0">{t('fitness.step2.body')}</p>
        </li>
        <li>
          <span class="fs-step-num">3</span>
          <h3 class="fs-h3">{t('fitness.step3.title')}</h3>
          <p class="fs-muted" style="margin:0">{t('fitness.step3.body')}</p>
        </li>
      </ol>
    </section>

    <!-- About -->
    <section class="fs-section">
      <p class="fs-eyebrow">{t('fitness.about.eyebrow')}</p>
      <div class="fs-about">
        <div class="fs-about-photo" style={`background-image: url(/fitness/hero.png); background-position: center 20%`}></div>
        <div>
          <h2 class="fs-h2" style="margin-bottom: 8px">{t('fitness.about.title')}</h2>
          <p class="fs-muted" style="margin:0 0 16px; max-width: 54ch">
            בניתי פלטפורמת בוטים בוואטסאפ עם מערכת ניהול מתקדמת: תמיכה בעברית, אינטגרציה ליומנים, מעקב אחרי שיחות. את הבוט שלך אני בונה אישית, בהתאמה לסטודיו שלך וצרכים שלך.
          </p>
          <p class="fs-muted" style="margin:0; max-width: 54ch">
            הצעד הראשון: שיחה אחת. בלי מצגת, בלי התחייבות. נבין אם זה מתאים לסטודיו שלך, ונחליט יחד.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="fs-section">
      <p class="fs-eyebrow">{t('fitness.faq.eyebrow')}</p>
      <h2 class="fs-h2">{t('fitness.faq.title')}</h2>
      <div class="fs-faq">

        <!-- Q1: Timeline -->
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness.faq.q1')}</span><span>+</span>
          </button>
          <div class="fs-faq-a">
            <p style="margin:0 0 12px">בין כמה שבועות לחודשיים, תלוי במפרט והיקף הבדיקות.</p>
            <p style="margin:0 0 6px">תהליך טיפוסי:</p>
            <ul style="margin:0; padding-right:18px; line-height:1.7">
              <li><strong>שלב הגדרה:</strong> מגדירים יחד את המפרט: איך הבוט מדבר, מה הוא יודע, אילו שיחות הוא מעביר אליכם.</li>
              <li><strong>שלב פיתוח:</strong> אני בונה ומטמיע. אתם בסטודיו, אני בעבודה.</li>
              <li><strong>שלב הרצה:</strong> עלייה הדרגתית בליווי שלי, עד שהכל עובד חלק.</li>
            </ul>
          </div>
        </div>

        <!-- Q2: Payment -->
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness.faq.q2')}</span><span>+</span>
          </button>
          <div class="fs-faq-a">
            <p style="margin:0 0 12px">שני חלקים, שקופים מההתחלה.</p>
            <p style="margin:0 0 8px"><strong>1. תשלום חד-פעמי על הפיתוח.</strong><br>נקבע בפגישה הראשונה לפי המפרט שנגדיר יחד. אתם מקבלים בוט מותאם אישית, ואת הקוד המלא שלו (<strong>שלכם לתמיד</strong>).</p>
            <p style="margin:0 0 12px"><strong>2. עלויות תפעול חודשיות.</strong><br>סדר גודל של מאות שקלים בחודש (תלוי בנפח השיחות), בגדול על אחסון, שירות ה-AI וחיבור לוואטסאפ. <strong>אלה שירותים חיצוניים שאתם משלמים עליהם ישירות, לא לי.</strong> שקיפות מלאה, בלי מחויבות חודשית כלפיי.</p>
            <p style="margin:0; font-style:italic; opacity:0.75">הסכומים נסגרים בפגישה הראשונה, לפני שמתחילים. אין הפתעות.</p>
          </div>
        </div>

        <!-- Q3: What's needed -->
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness.faq.q3')}</span><span>+</span>
          </button>
          <div class="fs-faq-a">{t('fitness.faq.a3')}</div>
        </div>

        <!-- Q4: Hebrew -->
        <div class="fs-faq-item" data-open="false">
          <button class="fs-faq-q">
            <span>{t('fitness.faq.q4')}</span><span>+</span>
          </button>
          <div class="fs-faq-a">{t('fitness.faq.a4')}</div>
        </div>

      </div>
    </section>

    <!-- Final CTA -->
    <section class="fs-section fs-section-dark">
      <h2 class="fs-h2">{t('fitness.finalcta.title')}</h2>
      <p class="fs-lede" style="max-width: 40ch">{t('fitness.finalcta.lede')}</p>
      <a class="fs-btn fs-btn-primary" href={waLink}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20">
          <path d="M19.05 4.91A10 10 0 0 0 4.6 18.96L3 23l4.16-1.55A10 10 0 1 0 19.05 4.91Zm-7 15.42a8.32 8.32 0 0 1-4.24-1.16l-.3-.18-2.46.92.92-2.4-.2-.31a8.34 8.34 0 1 1 6.28 3.13Zm4.57-6.24c-.25-.13-1.48-.73-1.71-.81s-.4-.13-.56.13-.65.81-.79.97-.29.2-.54.07a6.85 6.85 0 0 1-2.01-1.24 7.55 7.55 0 0 1-1.4-1.74c-.15-.25 0-.39.11-.51.11-.11.25-.29.37-.43a1.7 1.7 0 0 0 .25-.41.46.46 0 0 0 0-.43c-.07-.13-.56-1.36-.77-1.86s-.41-.43-.56-.43h-.48a.91.91 0 0 0-.66.31 2.78 2.78 0 0 0-.87 2.07 4.83 4.83 0 0 0 1 2.55 11.06 11.06 0 0 0 4.23 3.74 14.32 14.32 0 0 0 1.41.52 3.39 3.39 0 0 0 1.56.1 2.55 2.55 0 0 0 1.67-1.18 2.07 2.07 0 0 0 .14-1.18c-.06-.13-.23-.2-.48-.33Z" />
        </svg>
        <span>{t('fitness.finalcta.cta')}</span>
      </a>
    </section>

    <!-- Footer -->
    <footer class="fs-footer">
      <div>{t('fitness.footer.copyright')}</div>
      <div style="display:flex; gap:18px">
        <a href={`tel:${siteContact.phoneTel}`}>{siteContact.phoneDisplay}</a>
        <a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
      </div>
    </footer>

  </div>
</FitnessLayout>

<script>
  document.querySelectorAll<HTMLElement>('.fs-faq-item').forEach((item) => {
    item.querySelector('.fs-faq-q')?.addEventListener('click', () => {
      const isOpen = item.dataset.open === 'true';
      document.querySelectorAll<HTMLElement>('.fs-faq-item').forEach((el) => {
        el.dataset.open = 'false';
      });
      item.dataset.open = isOpen ? 'false' : 'true';
    });
  });
</script>
