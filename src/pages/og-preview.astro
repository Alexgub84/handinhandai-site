---
import { useTranslations } from '@i18n/utils';
import { defaultLang } from '@i18n/ui';

if (import.meta.env.PROD) {
  return Astro.redirect('/');
}

const t = useTranslations(defaultLang);
const base = 'http://localhost:4321';

const routes = [
  {
    label: 'Main · /',
    url: `${base}/`,
    title: t('site.title'),
    description: t('site.description'),
    image: `${base}/og/default.png`,
  },
  {
    label: 'Fitness Studio · /fitness-studio',
    url: `${base}/fitness-studio`,
    title: t('fitness-studio.page.title'),
    description: t('fitness-studio.hero.lede'),
    image: `${base}/og/fitness-studio/og.jpg`,
  },
  {
    label: 'Fitness Chain · /fitness-chain',
    url: `${base}/fitness-chain`,
    title: t('fitness-chain.page.title'),
    description: t('fitness-chain.hero.lede'),
    image: `${base}/og/fitness-chain/og.jpg`,
  },
  {
    label: 'Contact · /contact',
    url: `${base}/contact`,
    title: t('site.title'),
    description: t('site.description'),
    image: `${base}/og/default.png`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OG Preview (dev only)</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #0f0f0f;
        color: #f0f0f0;
        padding: 40px 24px;
        min-height: 100vh;
      }

      h1 {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 6px;
        color: #fff;
      }
      .subtitle {
        font-size: 13px;
        color: #666;
        margin-bottom: 48px;
      }

      .route-block {
        margin-bottom: 72px;
      }
      .route-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #555;
        margin-bottom: 20px;
      }

      .cards-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 24px;
      }

      /* ─── Platform label ─── */
      .platform-wrap {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .platform-name {
        font-size: 11px;
        font-weight: 600;
        color: #444;
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      /* ─── WhatsApp card ─── */
      .wa-bubble {
        background: #1f2c34;
        border-radius: 12px;
        padding: 12px;
        max-width: 360px;
      }
      .wa-card {
        border-radius: 8px;
        overflow: hidden;
        background: #2a3942;
        cursor: pointer;
      }
      .wa-card img {
        width: 100%;
        height: 190px;
        object-fit: cover;
        display: block;
      }
      .wa-card-body {
        padding: 8px 12px 10px;
      }
      .wa-card-site {
        font-size: 11px;
        color: #8696a0;
        margin-bottom: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .wa-card-title {
        font-size: 14px;
        font-weight: 600;
        color: #e9edef;
        line-height: 1.3;
        margin-bottom: 3px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .wa-card-desc {
        font-size: 12px;
        color: #8696a0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* ─── Facebook / LinkedIn card ─── */
      .fb-card {
        border: 1px solid #3a3a3a;
        border-radius: 4px;
        overflow: hidden;
        background: #1c1c1c;
        max-width: 500px;
      }
      .fb-card img {
        width: 100%;
        height: 260px;
        object-fit: cover;
        display: block;
      }
      .fb-card-body {
        padding: 12px 16px;
        border-top: 1px solid #3a3a3a;
      }
      .fb-card-domain {
        font-size: 11px;
        color: #777;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
      }
      .fb-card-title {
        font-size: 16px;
        font-weight: 600;
        color: #e4e4e4;
        line-height: 1.3;
        margin-bottom: 5px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .fb-card-desc {
        font-size: 13px;
        color: #999;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* ─── Twitter card ─── */
      .tw-card {
        border: 1px solid #2f3336;
        border-radius: 16px;
        overflow: hidden;
        background: #16181c;
        max-width: 500px;
        position: relative;
      }
      .tw-card img {
        width: 100%;
        height: 260px;
        object-fit: cover;
        display: block;
      }
      .tw-card-label {
        position: absolute;
        bottom: 12px;
        left: 12px;
        background: rgba(0,0,0,0.65);
        backdrop-filter: blur(4px);
        border-radius: 4px;
        padding: 4px 10px;
        max-width: calc(100% - 24px);
      }
      .tw-card-title {
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .tw-card-domain {
        font-size: 12px;
        color: rgba(255,255,255,0.6);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* ─── Image missing notice ─── */
      .img-missing {
        width: 100%;
        height: 190px;
        background: #1a1a2e;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #555;
        font-size: 13px;
      }
      .img-missing svg { opacity: 0.4; }

      hr { border: none; border-top: 1px solid #1e1e1e; margin: 72px 0 0; }
    </style>
  </head>
  <body>
    <h1>OG / Social Preview</h1>
    <p class="subtitle">Dev only: preview how links look on each platform when shared.</p>

    {routes.map((route) => (
      <div class="route-block">
        <div class="route-label">{route.label}</div>
        <div class="cards-row">

          <!-- WhatsApp -->
          <div class="platform-wrap">
            <span class="platform-name">WhatsApp</span>
            <div class="wa-bubble">
              <div class="wa-card">
                <img
                  src={route.image}
                  alt=""
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
                />
                <div class="img-missing" style="display:none">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 9 4-4 4 4 4-5 4 5"/><circle cx="8.5" cy="13.5" r="1.5"/></svg>
                  image not found
                </div>
                <div class="wa-card-body">
                  <div class="wa-card-site">handinhandai.com</div>
                  <div class="wa-card-title">{route.title}</div>
                  <div class="wa-card-desc">{route.description}</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Facebook / LinkedIn -->
          <div class="platform-wrap">
            <span class="platform-name">Facebook · LinkedIn</span>
            <div class="fb-card">
              <img
                src={route.image}
                alt=""
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
              />
              <div class="img-missing" style="display:none; height:260px">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 9 4-4 4 4 4-5 4 5"/><circle cx="8.5" cy="13.5" r="1.5"/></svg>
                image not found
              </div>
              <div class="fb-card-body">
                <div class="fb-card-domain">handinhandai.com</div>
                <div class="fb-card-title">{route.title}</div>
                <div class="fb-card-desc">{route.description}</div>
              </div>
            </div>
          </div>

          <!-- Twitter / X -->
          <div class="platform-wrap">
            <span class="platform-name">Twitter / X</span>
            <div class="tw-card">
              <img
                src={route.image}
                alt=""
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
              />
              <div class="img-missing" style="display:none; height:260px">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 9 4-4 4 4 4-5 4 5"/><circle cx="8.5" cy="13.5" r="1.5"/></svg>
                image not found
              </div>
              <div class="tw-card-label">
                <div class="tw-card-title">{route.title}</div>
                <div class="tw-card-domain">handinhandai.com</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    ))}
  </body>
</html>
