---
import CinematicLayout from '@layouts/CinematicLayout.astro';
import ScrollHero from '@components/scroll-hero/ScrollHero.astro';
import { defaultLang } from '@i18n/ui';

const lang = defaultLang;
---

<CinematicLayout
  lang={lang}
  title="Hand in Hand AI — תפסיקו להריץ תוכנה, תתחילו לנהל עסק"
  description="צוות AI מותאם אישית לעסק שלכם — מחובר לכל המערכות, עובד מסביב לשעון, מטפל בעבודה התפעולית כדי שתוכלו להתמקד במה שחשוב."
>
  <ScrollHero lang={lang} />
</CinematicLayout>
