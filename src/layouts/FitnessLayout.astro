---
import "@/vendor/whatsapp-chat-mock/styles.css";
import '@styles/hiha-tokens.css';
import '@styles/fitness.css';
import { type Lang } from '@i18n/ui';
import { getDirection } from '@i18n/utils';
import SEOHead from '@components/SEOHead.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  pageType?: string;
}

const {
  lang,
  title = 'צ׳טבוט חכם לסטודיו',
  description = 'צ׳טבוט חכם בוואטסאפ לסטודיו שלכם, שעונה ללקוחות, קובע שיעורי ניסיון ומזכיר על אימונים',
  ogImage = '/og/fitness/og.jpg',
  pageType = 'website',
} = Astro.props;
const dir = getDirection(lang);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />

    <SEOHead
      lang={lang}
      title={title}
      description={description}
      ogImage={ogImage}
      pageType={pageType}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
