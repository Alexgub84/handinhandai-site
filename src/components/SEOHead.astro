---
import { type Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogImage?: string;
  pageType?: string;
  /** Inject Organization JSON-LD (default true). Set false on pages that already render it. */
  includeOrganizationSchema?: boolean;
}

const {
  lang,
  title,
  description,
  ogImage = '/og/default.jpg',
  pageType = 'website',
  includeOrganizationSchema = true,
} = Astro.props;

const SITE_FALLBACK = 'https://handinhandai.com';
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || SITE_FALLBACK;
const siteBase = Astro.site ?? `${SITE_FALLBACK}/`;

// Canonical URL = current page as served (lang prefix included).
const fullUrl = new URL(Astro.url.pathname, siteBase).toString();

// OG image → absolute URL.
const fullImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteBase).toString();

// hreflang: derive the language-neutral path from current pathname, then emit
// both Hebrew (default, no prefix) and English (/en prefix) variants.
const pathname = Astro.url.pathname;
const parts = pathname.split('/').filter(Boolean);
const neutralPath = parts[0] === 'en' ? '/' + parts.slice(1).join('/') : pathname;
const cleanNeutral = neutralPath === '' ? '/' : neutralPath;
const enPath = cleanNeutral === '/' ? '/en/' : `/en${cleanNeutral}`;
const hePath = cleanNeutral;
const hrefHe = `${siteOrigin}${hePath}`;
const hrefEn = `${siteOrigin}${enPath}`;

const pageTitle = `${title} | Hand in Hand AI`;

// Organization JSON-LD — WhatsApp contactPoint sourced from Header.
const WHATSAPP_E164 = '+972545053620';
const WHATSAPP_URL = 'https://wa.me/972545053620';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: 'Hand in Hand AI',
  url: siteOrigin,
  logo: `${siteOrigin}/logo.png`,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      telephone: WHATSAPP_E164,
      url: WHATSAPP_URL,
      availableLanguage: ['Hebrew', 'English'],
    },
  ],
};
---
<!-- Primary meta -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={fullUrl} />

<!-- hreflang: x-default → English per issue #16 spec -->
<link rel="alternate" hreflang="he" href={hrefHe} />
<link rel="alternate" hreflang="en" href={hrefEn} />
<link rel="alternate" hreflang="x-default" href={hrefEn} />

<!-- Open Graph -->
<meta property="og:type" content={pageType} />
<meta property="og:url" content={fullUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Hand in Hand AI" />
<meta property="og:locale" content={lang === 'he' ? 'he_IL' : 'en_US'} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />

{includeOrganizationSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
)}
