---
/**
 * Inline SVG icon set — replaces iconsax-react (zero runtime deps).
 * Stroke icons use currentColor; filled icons (whatsapp, tick-circle) fill currentColor.
 */
interface Props {
  name: string;
  size?: number;
  color?: string;
  class?: string;
}
const { name, size = 24, color, class: className } = Astro.props;
const s = size;
const style = color ? `color:${color}` : undefined;
const stroke = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.7",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

{name === "whatsapp" && (
  <svg width={s} height={s} viewBox="0 0 24 24" fill="currentColor" style={style} class={className} aria-hidden="true">
    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-3-.2-.3a8.2 8.2 0 1 1 7.1 3.9zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.4-3c-.3-.4 0-.5.2-.7l.4-.5c.1-.2.1-.3 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1.1 2.7c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.6-.5z" />
  </svg>
)}

{name === "tick-circle" && (
  <svg width={s} height={s} viewBox="0 0 24 24" fill="currentColor" style={style} class={className} aria-hidden="true">
    <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.7 7.7-5.3 5.3a1 1 0 0 1-1.4 0L7.3 12.3a1 1 0 1 1 1.4-1.4l1.99 2 4.6-4.6a1 1 0 0 1 1.4 1.4z" />
  </svg>
)}

{name === "calendar" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <rect x="3" y="5" width="18" height="16" rx="2.5" /><path d="M3 9h18M8 3v4M16 3v4" />
  </svg>
)}

{name === "calendar-tick" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <rect x="3" y="5" width="18" height="16" rx="2.5" /><path d="M3 9h18M8 3v4M16 3v4M8.5 15l2.2 2.2L15.5 12" />
  </svg>
)}

{name === "global" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.4 3.9 5.6 4 9-.1 3.4-1.5 6.6-4 9-2.5-2.4-3.9-5.6-4-9 .1-3.4 1.5-6.6 4-9z" />
  </svg>
)}

{name === "sms" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 5 8-5" />
  </svg>
)}

{name === "task-square" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="4" /><path d="m7.5 12 2 2 4.5-4.5M16.5 14.5H17" />
  </svg>
)}

{name === "arrow-left" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <path d="M19 12H5M11 6l-6 6 6 6" />
  </svg>
)}

{name === "send" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <path d="M21 3 3 10.5l7 2.5 2.5 7L21 3zM10 13l4-4" />
  </svg>
)}

{name === "people" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <circle cx="9" cy="8" r="3.2" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 5.2a3.2 3.2 0 0 1 0 6M17 19a5.5 5.5 0 0 0-2.2-4.4" />
