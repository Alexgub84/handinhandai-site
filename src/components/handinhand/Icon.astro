    <path d="M3 17l6-6 4 4 8-8M15 7h6v6" />
  </svg>
)}

{name === "cloud" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <path d="M7 18a4 4 0 0 1-.5-7.97A5.5 5.5 0 0 1 17 9.5a3.5 3.5 0 0 1 .5 8.5H7z" />
  </svg>
)}

{name === "cpu" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <rect x="6" y="6" width="12" height="12" rx="2.5" /><path d="M9.5 9.5h5v5h-5zM9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" />
  </svg>
)}

{name === "shopping-cart" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <path d="M3 4h2l2.2 11.2a1.5 1.5 0 0 0 1.5 1.2h7.6a1.5 1.5 0 0 0 1.5-1.2L20 7H6" /><circle cx="9.5" cy="20" r="1.3" /><circle cx="17" cy="20" r="1.3" />
  </svg>
)}

{name === "buildings2" && (
