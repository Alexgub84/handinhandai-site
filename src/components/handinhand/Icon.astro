    <circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1" />
  </svg>
)}

{name === "speedometer" && (
  <svg width={s} height={s} viewBox="0 0 24 24" {...stroke} style={style} class={className} aria-hidden="true">
    <path d="M4 19a9 9 0 1 1 16 0" /><path d="M12 14l4-4" /><circle cx="12" cy="14" r="1.3" fill="currentColor" stroke="none" />
  </svg>
)}
