---
import Icon from "./Icon.astro";

/* מרחב עיצוב קבוע 480×520; ה-stage מותאם לרוחב ב-ResizeObserver (home script).
   ריחוף = CSS keyframes; פעימות = SVG SMIL. דקורטיבי. */
const SATS = [
  { key: "wa", icon: "whatsapp", color: "#1f9d55", x: 34, y: 18 },
  { key: "mail", icon: "sms", color: "#d24a3c", x: 170, y: 18 },
  { key: "cal", icon: "calendar", color: "#3b78d8", x: 34, y: 82 },
  { key: "web", icon: "global", color: "#2f9e48", x: 170, y: 82 },
];
const HUB = { cx: 102, cy: 50 };
const AUTO_ROWS = [
  { text: "אישור הגעה נשלח ללקוחה", time: "21:14" },
  { text: "התור עודכן ביומן", time: "21:14" },
];
const WIRES = [
  { id: "w1", d: "M 420 256 C 402 240, 392 230, 372 218", begin: "1.6s" },
  { id: "w2", d: "M 56 326 C 80 338, 98 344, 116 348", begin: "2.2s" },
  { id: "w3", d: "M 416 372 C 400 378, 388 382, 366 388", begin: "2.8s" },
];
---

<div class="hs" data-hub>
  <div class="hs__stage" data-hub-stage style="width:480px;height:520px">
    <span class="hs__glow" style="left:104px;top:112px;width:282px;height:282px" aria-hidden="true"></span>

    <svg class="hs__wires" viewBox="0 0 480 520" aria-hidden="true">
      {WIRES.map((w) => <path class="hs-wire" d={w.d} />)}
      {WIRES.map((w) => (
        <circle class="hs-wirepulse" r="4" cx="0" cy="0" opacity="0">
          <animateMotion dur="1.5s" begin={w.begin} repeatCount="indefinite" path={w.d} keyPoints="0;1" keyTimes="0;1" calcMode="linear" />
          <animate attributeName="opacity" dur="1.5s" begin={w.begin} repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.12;0.8;1" />
        </circle>
      ))}
    </svg>

    <!-- כרטיס: רכזת אינטגרציות -->
    <div class="hs__card hs__card--int hs__float" style="left:12px;top:50px;width:216px;height:210px">
      <div class="hs-hub" aria-hidden="true">
        <svg class="hs-hub__wires" viewBox="0 0 204 108">
          {SATS.map((s) => <line x1={HUB.cx} y1={HUB.cy} x2={s.x} y2={s.y} class="hs-hub__line" />)}
          {SATS.map((s, i) => (
            <circle class="hs-hub__pulse" r="3.5" cx={s.x} cy={s.y} opacity="0">
              <animate attributeName="cx" dur="1.1s" begin={`${1.4 + i * 0.5}s`} repeatCount="indefinite" values={`${s.x};${HUB.cx}`} keyTimes="0;1" />
              <animate attributeName="cy" dur="1.1s" begin={`${1.4 + i * 0.5}s`} repeatCount="indefinite" values={`${s.y};${HUB.cy}`} keyTimes="0;1" />
              <animate attributeName="opacity" dur="1.1s" begin={`${1.4 + i * 0.5}s`} repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.15;0.8;1" />
            </circle>
          ))}
        </svg>
        {SATS.map((s) => (
          <span class="hs-app" style={`left:${(s.x / 204) * 100}%;top:${(s.y / 108) * 100}%;color:${s.color}`}>
            <Icon name={s.icon} size={16} />
          </span>
        ))}
        <span class="hs-hub__core" style={`left:${(HUB.cx / 204) * 100}%;top:${(HUB.cy / 108) * 100}%`}>
          <img src="/handinhand-logo.png" alt="" width="26" height="26" />
        </span>
      </div>
      <p class="hs-card__title">אינטגרציה ללא מאמץ</p>
      <p class="hs-card__desc">מתחבר לכל הכלים שכבר יש לכם — בלי קוד.</p>
    </div>

    <!-- כרטיס: סשה עונה ללקוח -->
    <div class="hs__card hs__card--chat hs__float" style="left:256px;top:54px;width:208px;height:166px">
      <div class="hs-chat__head">
        <span class="hs-chat__avatar">ס</span>
        <span class="hs-chat__name">סשה · עונה מיד</span>
      </div>
      <span class="hs-chat__bubble hs-chat__bubble--user">אפשר תור למחר?</span>
      <span class="hs-chat__bubble hs-chat__bubble--agent">בכיף! קבעתי ל־10:00 📅</span>
    </div>

    <!-- כרטיס: אוטומציה -->
    <div class="hs__card hs__card--rows hs__float" style="left:116px;top:296px;width:248px;height:150px">
      <p class="hs-card__title hs-card__title--sm">רץ לבד ברקע</p>
      {AUTO_ROWS.map(({ text, time }) => (
        <span class="hs-row">
          <Icon name="tick-circle" size={15} color="var(--green-accent)" />
          {text}
          <time>{time}</time>
        </span>
      ))}
    </div>

    <!-- אריחי אפליקציות צפים -->
    <span class="hs__chip hs__float" style="left:404px;top:238px;width:50px;height:50px">
      <Icon name="whatsapp" size={24} color="#1f9d55" />
    </span>
    <span class="hs__chip hs__float" style="left:22px;top:304px;width:46px;height:46px">
      <Icon name="calendar" size={22} color="#3b78d8" />
    </span>
    <span class="hs__chip hs__float" style="left:404px;top:356px;width:44px;height:44px">
      <Icon name="task-square" size={22} color="#e07b39" />
    </span>
  </div>
</div>
