---
import "@styles/handinhand/tokens.css";
import "@styles/handinhand/base.css";
import "@styles/handinhand/app.css";
import ScrollProgress from "@components/handinhand/ScrollProgress.astro";
import NavBar from "@components/handinhand/NavBar.astro";
import Hero from "@components/handinhand/Hero.astro";
import AlexSection from "@components/handinhand/AlexSection.astro";
import Capabilities from "@components/handinhand/Capabilities.astro";
import ExampleSection from "@components/handinhand/ExampleSection.astro";
import HowItWorks from "@components/handinhand/HowItWorks.astro";
import AudienceSection from "@components/handinhand/AudienceSection.astro";
import FinalCTA from "@components/handinhand/FinalCTA.astro";
import Footer from "@components/handinhand/Footer.astro";
import FloatingWhatsApp from "@components/handinhand/FloatingWhatsApp.astro";

/* Shared homepage document. Rendered by both `/` (Hebrew default) and `/en`
   — identical Hebrew content; canonical always points to `/` to dedupe. */
const title = "handinhand — עסק שמתנהל חכם מרוויח יותר";
const description =
  "אלכס בונה לעסקים מערכת חכמה שמתחברת למייל, לוואטסאפ, לאתר ולכלים שכבר יש לכם — ולוקחת על עצמה את העבודה הרוטינית שאוכלת את היום. שיחת אבחון ראשונה — בלי התחייבות.";
const ogDescription =
  "מערכת אחת שמנהלת את כל העסק: מייל, וואטסאפ, אתר, הזמנות ומשימות — עם AI שמתאים לכם. עובדים יד ביד.";
const site = Astro.site ?? new URL("https://handinhandai.com");
const canonical = new URL("/", site).href;
const ogImage = new URL("/og/home/og.jpg", site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "handinhand",
  alternateName: "יד ביד",
  url: canonical,
  logo: new URL("/handinhand-logo.png", site).href,
  image: ogImage,
  slogan: "עסק שמתנהל חכם מרוויח יותר",
  description:
    "אלכס בונה לעסקים מערכת חכמה שמתחברת למייל, לוואטסאפ, לאתר ולכלים הקיימים, עם בינה מלאכותית בכל שלב שחוסך זמן — מענה, תיאומים, תזכורות ומעקבים.",
  areaServed: { "@type": "Country", name: "Israel" },
  availableLanguage: "he",
  founder: { "@type": "Person", name: "אלכס", jobTitle: "מייסד ומפתח" },
  knowsAbout: ["אוטומציה לעסקים", "בינה מלאכותית", "מערכות ניהול עסק", "סוכני AI", "וואטסאפ לעסקים"],
};
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fbfaf6" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="handinhand" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/handinhand-logo.png" />
    <link rel="apple-touch-icon" href="/handinhand-logo.png" />

    <link rel="preload" href="/fonts/Discovery_Fs-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Discovery_Fs-Demibold.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן</a>
    <ScrollProgress />
    <NavBar />
    <main id="main">
      <Hero />
      <AlexSection />
      <Capabilities />
      <ExampleSection />
      <HowItWorks />
      <AudienceSection />
      <FinalCTA />
    </main>
    <Footer />
    <FloatingWhatsApp />

    <script>
      import { waLink } from "@/data/site-contact";

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* ── חשיפה בגלילה ── */
      const reveals = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduced || !("IntersectionObserver" in window)) {
        reveals.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        reveals.forEach((el) => io.observe(el));
      }

      /* ── נאב: רקע בגלילה ── */
      const nav = document.querySelector(".nav");
      if (nav) {
        const onScroll = () => nav.classList.toggle("nav--scrolled", window.scrollY > 24);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      /* ── נאב: הדגשת הקישור הפעיל ── */
      const navLinks = Array.from(document.querySelectorAll<HTMLElement>("[data-navlink]"));
      if (navLinks.length) {
        const linkIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                navLinks.forEach((a) =>
                  a.classList.toggle("is-active", a.getAttribute("data-navlink") === e.target.id)
                );
              }
            });
          },
          { rootMargin: "-45% 0px -45% 0px" }
        );
        navLinks.forEach((a) => {
          const sec = document.getElementById(a.getAttribute("data-navlink") || "");
          if (sec) linkIo.observe(sec);
        });
      }

      /* ── תפריט נייד ── */
      const burger = document.querySelector(".nav__burger");
      const closeMenu = () => {
        nav?.classList.remove("nav--open");
        burger?.setAttribute("aria-expanded", "false");
      };
      burger?.addEventListener("click", () => {
        const open = nav?.classList.toggle("nav--open");
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
      document.querySelectorAll("[data-mobilelink]").forEach((a) => a.addEventListener("click", closeMenu));
      window.addEventListener("keydown", (e) => e.key === "Escape" && closeMenu());
      window.addEventListener("resize", () => window.innerWidth > 880 && closeMenu());

      /* ── ציר "איך מתחילים": שלב פעיל ── */
      const steps = Array.from(document.querySelectorAll<HTMLElement>("[data-step]"));
      if (steps.length && !reduced) {
        const stepIo = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.target.classList.toggle("is-active", e.isIntersecting)),
          { rootMargin: "-40% 0px -40% 0px" }
        );
        steps.forEach((s) => stepIo.observe(s));
      } else {
        steps.forEach((s) => s.classList.add("is-active"));
      }

      /* ── כפתור ווטסאפ צף ── */
      const floatWa = document.querySelector(".float-wa");
      const hero = document.querySelector(".hero");
      if (floatWa && hero) {
        const fIo = new IntersectionObserver(
          ([e]) => floatWa.classList.toggle("show", !e.isIntersecting),
          { threshold: 0 }
        );
        fIo.observe(hero);
      }
      document
        .querySelector("[data-floatwa-close]")
        ?.addEventListener("click", () =>
          document.querySelector("[data-floatwa-bubble]")?.classList.add("is-closed")
        );

      /* ── ChatDemo: טקסט חופשי → wa.me ── */
      const chatInput = document.querySelector<HTMLInputElement>("[data-chat-input]");
      const chatSend = document.querySelector("[data-chat-send]");
      const sendChat = () => {
        const text = chatInput?.value.trim();
        if (!text) return;
        window.open(waLink(text), "_blank", "noopener,noreferrer");
        if (chatInput) chatInput.value = "";
      };
      chatSend?.addEventListener("click", sendChat);
      chatInput?.addEventListener("keydown", (e) => e.key === "Enter" && sendChat());

      /* ── DiagChat: מחזוריות תרחישים ── */
      const dchat = document.querySelector("[data-dchat]");
      if (dchat && !reduced) {
        const data = dchat.querySelector("[data-dchat-json]");
        const scenarios: { pain: string; reply: string }[] = data
          ? JSON.parse(data.textContent || "[]")
          : [];
        const convo = dchat.querySelector("[data-dchat-convo]");
        const dots = Array.from(dchat.querySelectorAll("[data-dchat-dots] span"));
        let idx = 0;
        const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
        const render = (i: number, step: number) => {
          if (!convo) return;
          const sc = scenarios[i];
          dots.forEach((d, di) => d.classList.toggle("is-on", di === i));
          convo.classList.toggle("is-fading", step === 4);
          if (step === 4) return;
          let html = `<span class="dchat__msg dchat__msg--user">${sc.pain}</span>`;
          if (step === 2) html += `<span class="dchat__typing"><i></i><i></i><i></i></span>`;
          if (step >= 3) html += `<span class="dchat__msg dchat__msg--agent">${sc.reply}</span>`;
          convo.innerHTML = html;
        };
        (async () => {
          if (!scenarios.length) return;
          // eslint-disable-next-line no-constant-condition
          while (true) {
            render(idx, 1); await wait(1500);
            render(idx, 2); await wait(1100);
            render(idx, 3); await wait(2700);
            render(idx, 4); await wait(550);
            idx = (idx + 1) % scenarios.length;
          }
        })();
      }

      /* ── Hero hub: התאמת קנה-מידה לרוחב ── */
      const hub = document.querySelector<HTMLElement>("[data-hub]");
      const stage = document.querySelector<HTMLElement>("[data-hub-stage]");
      if (hub && stage) {
        const fit = () => {
          stage.style.transform = `scale(${hub.clientWidth / 480})`;
        };
        fit();
        new ResizeObserver(fit).observe(hub);
      }
    </script>
  </body>
</html>
