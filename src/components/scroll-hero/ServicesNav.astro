---
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const services = lang === 'he' ? {
  title: 'הפתרונות שלנו',
  kicker: 'שירותים',
  items: [
    {
      title: 'סטודיו כושר',
      description: 'עוזר AI בוואטסאפ לסטודיו הכושר שלכם — עונה ללקוחות, קובע שיעורי ניסיון, ומזכיר על אימונים',
      href: '/fitness-studio',
      icon: '🏋️',
    },
    {
      title: 'רשת כושר',
      description: 'פתרון מותאם לרשתות כושר — ניהול לקוחות, אוטומציה של תהליכים, ואינטגרציה עם כל המערכות',
      href: '/fitness-chain',
      icon: '⛓️',
    },
  ],
} : {
  title: 'Our Solutions',
  kicker: 'Services',
  items: [
    {
      title: 'Fitness Studio',
      description: 'WhatsApp AI assistant for your studio — answers clients, books trials, and sends reminders',
      href: '/en/fitness-studio',
      icon: '🏋️',
    },
    {
      title: 'Fitness Chain',
      description: 'Custom solution for fitness chains — client management, workflow automation, and full system integration',
      href: '/en/fitness-chain',
      icon: '⛓️',
    },
  ],
};
---

<section class="services-nav" id="services">
  <div class="services-nav__inner">
    <div class="services-nav__header">
      <span class="services-nav__kicker">{services.kicker}</span>
      <h2 class="services-nav__title">{services.title}</h2>
    </div>
    <div class="services-nav__grid">
      {services.items.map((service) => (
        <a href={service.href} class="service-card">
          <div class="service-card__icon" aria-hidden="true">{service.icon}</div>
          <h3 class="service-card__title">{service.title}</h3>
          <p class="service-card__description">{service.description}</p>
          <span class="service-card__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services-nav {
    position: relative;
    width: 100%;
    padding: clamp(80px, 12vw, 160px) clamp(24px, 5vw, 80px);
    background: var(--c-bg);
    border-top: 1px solid var(--c-faint);
  }

  .services-nav__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .services-nav__header {
    margin-bottom: clamp(40px, 6vw, 64px);
    text-align: center;
  }

  .services-nav__kicker {
    display: block;
    margin-bottom: 12px;
    font-size: clamp(13px, 1.8vw, 15px);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-gold);
    opacity: 0.9;
  }

  .services-nav__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 900;
    line-height: 1.1;
    color: var(--c-ink);
  }

  .services-nav__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(20px, 3vw, 32px);
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4vw, 40px);
    background: var(--c-bg-2);
    border: 1px solid var(--c-faint);
    border-radius: 16px;
    transition: all 240ms cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
  }

  .service-card:hover {
    border-color: var(--c-gold);
    background: oklch(13% 0.016 250);
    transform: translateY(-2px);
    box-shadow: 
      0 8px 24px oklch(0% 0 0 / 0.24),
      0 0 0 1px var(--c-gold);
  }

  .service-card__icon {
    margin-bottom: 16px;
    font-size: clamp(32px, 4vw, 40px);
    line-height: 1;
  }

  .service-card__title {
    margin: 0 0 12px 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--c-ink);
  }

  .service-card__description {
    margin: 0 0 20px 0;
    font-size: clamp(14px, 1.8vw, 16px);
    line-height: 1.6;
    color: var(--c-muted);
    flex: 1;
  }

  .service-card__arrow {
    display: inline-block;
    font-size: 20px;
    color: var(--c-gold);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card:hover .service-card__arrow {
    transform: translateX(4px);
  }

  /* RTL adjustments */
  [dir="rtl"] .service-card__arrow {
    transform: scaleX(-1);
  }

  [dir="rtl"] .service-card:hover .service-card__arrow {
    transform: scaleX(-1) translateX(4px);
  }

  @media (max-width: 768px) {
    .services-nav__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
