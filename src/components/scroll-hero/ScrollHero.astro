---
import type { Lang } from '@i18n/ui';
import { getScenario } from './data/scenarios';
import ChaosToOrb from './ChaosToOrb';
import StoryFilm from './StoryFilm';
import CinematicLoader from './CinematicLoader';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = getScenario(lang);
---

<CinematicLoader client:load scenario={s} />

<header class="cinematic-topbar" aria-label="Top">
  <a href="/" class="cinematic-topbar__brand">
    <img src="/logo.png" alt="Hand in Hand AI" />
    <span>Hand in Hand AI</span>
  </a>
  <a class="cinematic-topbar__cta" href={s.cta.href}>
    {s.topbar.cta} <span aria-hidden="true">→</span>
  </a>
</header>

<ChaosToOrb client:load scenario={s} />

<!-- Chapters 2–7 as one pinned scroll-scrub film (issue #20) -->
<StoryFilm client:load scenario={s} />

<footer class="cinematic-footer">
  <div class="cinematic-footer__inner">
    <span>{s.footer.text}</span>
    <a href={lang === 'he' ? '/en/' : '/'}>{lang === 'he' ? 'English' : 'עברית'}</a>
  </div>
</footer>
