---
/* "מי מנהל לכם היום את העסק?" — dark section with the היום / אפשרי switch.
   Port of prototype `fu` (section#why). */
import LucideIcon from "./LucideIcon.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import type { IconName } from "./icons";
import { siteContact } from "@/data/site-contact";

const wa = siteContact.whatsappCta;

/* Floating app nodes: chaos position (c), chaos rotation (r), ordered position (o). */
const nodes: { icon: IconName | "whatsapp"; c: [number, number]; r: number; o: [number, number]; badge: string }[] = [
  { icon: "mail", c: [24, 20], r: -14, o: [50, 14], badge: "27" },
  { icon: "whatsapp", c: [66, 15], r: 11, o: [81.2, 32], badge: "43" },
  { icon: "sheet", c: [86, 50], r: -9, o: [81.2, 68], badge: "!" },
  { icon: "printer", c: [62, 76], r: 16, o: [50, 86], badge: "8" },
  { icon: "file-pen-line", c: [16, 62], r: 8, o: [18.8, 68], badge: "5" },
  { icon: "calendar", c: [38, 40], r: -20, o: [18.8, 32], badge: "2" },
];
const chaosLinks: [number, number, [number, number], [number, number]][] = [
  [0, 3, [80, 5], [5, 95]],
  [1, 4, [10, 20], [95, 90]],
  [2, 5, [20, 90], [70, 0]],
  [0, 2, [60, 70], [40, -5]],
  [3, 5, [95, 20], [0, 55]],
  [1, 3, [30, 60], [100, 100]],
  [4, 0, [70, 45], [-5, 10]],
];
const toasts = [
  { cls: "wr-t1", tr: "-4deg", d: ".2s", j: ".9s", bad: "ליד מלפני 3 ימים — מישהו חזר אליו?", ok: "ליד חדש טופל אוטומטית" },
  { cls: "wr-t2", tr: "5deg", d: ".45s", j: "1.1s", bad: "החשבונית עדיין במדפסת…", ok: "החשבונית נחתמה ונשלחה" },
  { cls: "wr-t3", tr: "-3deg", d: ".7s", j: ".8s", bad: 'הפרילנסר: "אז מה בדיוק לעשות?"', ok: "כל הנתונים סונכרנו" },
];
interface Face {
  icon: IconName;
  title: string;
  text: string;
}
const cards: { bad: Face; ok: Face }[] = [
  {
    bad: { icon: "puzzle", title: "עבודה בטלאים", text: "קופצים בין 5 מערכות שונות שלא מדברות אחת עם השנייה — ומעתיקים נתונים ביד." },
    ok: { icon: "boxes", title: "מערכת מרכזית אחת", text: "מערכת Tailor-Made שנבנתה בדיוק לפי ה-DNA והצרכים של העסק שלכם." },
  },
  {
    bad: { icon: "printer", title: "ידניות מיותרת", text: "מדפיסים חשבוניות, רודפים אחרי חתימות ומנהלים מעקב מתיש במייל ובוואטסאפ." },
    ok: { icon: "bot", title: "סוכני AI ואוטומציות", text: "לידים מטופלים אוטומטית, התקשורת בוואטסאפ מנוהלת, והמידע מסתנכרן ברגע." },
  },
  {
    bad: { icon: "lock", title: "התפשרות על תוכנות מדף", text: "העסק מתכופף למגבלות של התוכנה, במקום שהתוכנה תשרת את העסק." },
    ok: { icon: "gauge", title: "מקסימום יעילות ושקט", text: "עשרות שעות עבודה ידנית נחסכות. סדר מוחלט — ואפס משימות שנופלות בין הכיסאות." },
  },
  {
    bad: { icon: "user-search", title: "מרדף אחרי מפתחים", text: 'פרילנסרים עם "ראש קטן" — שמחכים שאתם תגידו להם מה לעשות.' },
    ok: { icon: "handshake", title: "שותף חושב ומנהל", text: "מוביל טכנולוגי שלוקח אחריות על כל התהליך — מאפיון הבעיה ועד הטמעה מלאה." },
  },
];
---

<section id="why" dir="rtl" aria-labelledby="wr-title" class="wr theme-dark bg-background font-sans text-foreground" data-why>
  <div class="wr-grid" aria-hidden="true"></div>
  <div class="wr-glow" aria-hidden="true"></div>
  <div class="wr-wrap">
    <header class="wr-head">
      <h2 id="wr-title">
        מי מנהל לכם היום<br />
        <span class="wr-h2-accent">את העסק?<span class="wr-ok" aria-hidden="true">את העסק?</span></span>
      </h2>
      <p class="wr-sub">אתם — או הבלגן? ברוב העסקים, מי שבאמת מנהל את היום הוא אוסף של מערכות, קבצים והודעות. לחצו על המתג וראו מה קורה כשהכל מתחבר.</p>
      <div class="wr-switch-row">
        <div class="wr-switch" role="group" aria-label="היום מול אפשרי">
          <span class="wr-thumb" aria-hidden="true"></span>
          <button type="button" aria-pressed="true" data-mode="chaos">
            <LucideIcon name="triangle-alert" class="wr-i" /> היום
          </button>
          <button type="button" aria-pressed="false" data-mode="order">
            <LucideIcon name="wand-sparkles" class="wr-i" /> אפשרי
          </button>
        </div>
      </div>
    </header>

    <div class="wr-body">
      <div class="wr-os" aria-hidden="true">
        <div class="wr-stage" data-stage>
          <svg class="wr-links" viewBox="0 0 100 100" preserveAspectRatio="none">
            <g class="wr-chaos-links">
              {chaosLinks.map(([a, b, c1, c2]) => {
                const p = nodes[a].c;
                const q = nodes[b].c;
                return <path d={`M${p[0]} ${p[1]} C${c1[0]} ${c1[1]} ${c2[0]} ${c2[1]} ${q[0]} ${q[1]}`}></path>;
              })}
            </g>
            <g class="wr-order-links">
              <circle class="wr-ring" cx="50" cy="50" r="36"></circle>
              {nodes.map((n, i) => {
                const d = `M${n.o[0]} ${n.o[1]} L50 50`;
                return (
                  <g>
                    <path d={d}></path>
                    <circle class="wr-pk" r="1.1">
                      <animateMotion dur={`${(1.6 + i * 0.15).toFixed(2)}s`} repeatCount="indefinite" path={d} begin={`${(i * 0.25).toFixed(2)}s`}></animateMotion>
                    </circle>
                  </g>
                );
              })}
            </g>
          </svg>

          <div class="wr-hub">
            <div class="wr-hub-face wr-hub-bad"><span class="wr-hub-q">?</span><b>מי אחראי?</b></div>
            <div class="wr-hub-face wr-hub-ok"><LucideIcon name="sparkles" class="wr-i" /><b>מערכת אחת</b></div>
          </div>

          {nodes.map((n, i) => (
            <div
              class="wr-node"
              style={`--cx:${n.c[0]}%;--cy:${n.c[1]}%;--cr:${n.r}deg;--ox:${n.o[0]}%;--oy:${n.o[1]}%;--d:${i * 0.07}s;--j:${(0.18 + i * 0.05).toFixed(2)}s`}
            >
              <div class="wr-node-in">
                {n.icon === "whatsapp" ? <WhatsAppIcon class="wr-i" /> : <LucideIcon name={n.icon} class="wr-i" />}
                <span class="wr-badge">{n.badge}</span>
              </div>
            </div>
          ))}

          {toasts.map((t) => (
            <div class:list={["wr-toast", t.cls]} style={`--tr:${t.tr};--d:${t.d};--j:${t.j}`}>
              <span class="wr-ic">
                <LucideIcon name="triangle-alert" class="wr-i wr-i-bad" />
                <LucideIcon name="check" class="wr-i wr-i-ok" />
              </span>
              <span class="wr-t"><span class="wr-t-bad">{t.bad}</span><span class="wr-t-ok">{t.ok}</span></span>
            </div>
          ))}

          <div class="wr-burst" data-burst></div>
        </div>
      </div>

      <div>
        <div class="wr-cards-head">
          <h3 class="wr-h-bad" data-h-bad>איפה העסק שלכם נמצא <span>היום?</span></h3>
          <h3 class="wr-h-ok" data-h-ok aria-hidden="true">איפה העסק שלכם <span>יכול להיות?</span></h3>
        </div>
        <div class="wr-cards">
          {cards.map((c, i) => (
            <div class="wr-flip" style={`--d:${(0.35 + i * 0.14).toFixed(2)}s`}>
              <div class="wr-flip-in">
                <div class="wr-face wr-bad" data-face="bad">
                  <div class="wr-face-top"><span class="wr-f-ic"><LucideIcon name={c.bad.icon} class="wr-i" /></span></div>
                  <h4>{c.bad.title}</h4>
                  <p>{c.bad.text}</p>
                </div>
                <div class="wr-face wr-ok" data-face="ok" aria-hidden="true">
                  <div class="wr-face-top"><span class="wr-f-ic"><LucideIcon name={c.ok.icon} class="wr-i" /></span></div>
                  <h4>{c.ok.title}</h4>
                  <p>{c.ok.text}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="wr-cta">
          <a class="wr-btn" href={wa} target="_blank" rel="noopener noreferrer">
            אני רוצה את הצד הזה <LucideIcon name="arrow-left" class="wr-i" />
          </a>
          <small>שיחת אבחון ראשונה — בלי התחייבות</small>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type Mode = "chaos" | "order";
  const section = document.querySelector<HTMLElement>("[data-why]");
  if (section) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const stage = section.querySelector<HTMLElement>("[data-stage]");
    const burst = section.querySelector<HTMLElement>("[data-burst]");
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-mode]"));
    const hBad = section.querySelector<HTMLElement>("[data-h-bad]");
    const hOk = section.querySelector<HTMLElement>("[data-h-ok]");
    const faces = Array.from(section.querySelectorAll<HTMLElement>("[data-face]"));
    let mode: Mode = "chaos";
    let userTouched = false;
    let burstTimer = 0;

    const particles = () => {
      if (!burst) return;
      burst.replaceChildren();
      const wave = document.createElement("span");
      wave.className = "wr-wave";
      burst.appendChild(wave);
      const colors = ["var(--primary)", "var(--cyan)", "var(--accent)"];
      for (let i = 0; i < 34; i++) {
        const angle = Math.random() * Math.PI * 2;
        const dist = 90 + Math.random() * 220;
        const p = document.createElement("span");
        p.className = "wr-p";
        p.style.setProperty("--dx", `${Math.cos(angle) * dist}px`);
        p.style.setProperty("--dy", `${Math.sin(angle) * dist}px`);
        p.style.setProperty("--s", `${3 + Math.random() * 5}px`);
        p.style.setProperty("--t", `${0.7 + Math.random() * 0.7}s`);
        p.style.setProperty("--c", colors[Math.floor(Math.random() * 3)]);
        burst.appendChild(p);
      }
      window.clearTimeout(burstTimer);
      burstTimer = window.setTimeout(() => burst.replaceChildren(), 1600);
    };

    const setMode = (next: Mode) => {
      if (mode === next) return;
      mode = next;
      const order = next === "order";
      section.classList.toggle("is-order", order);
      buttons.forEach((b) => b.setAttribute("aria-pressed", b.dataset.mode === next ? "true" : "false"));
      hBad?.setAttribute("aria-hidden", order ? "true" : "false");
      hOk?.setAttribute("aria-hidden", order ? "false" : "true");
      faces.forEach((f) => f.setAttribute("aria-hidden", (f.dataset.face === "ok") !== order ? "true" : "false"));
      if (order && !reduced) particles();
    };

    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        userTouched = true;
        setMode(b.dataset.mode as Mode);
      })
    );

    /* Auto-flip to "אפשרי" ~2s after the stage scrolls into view, unless the user already clicked. */
    if (stage) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          window.setTimeout(() => {
            if (!userTouched) setMode("order");
          }, 2200);
        },
        { threshold: 0.45 }
      );
      io.observe(stage);
    }
  }
</script>
