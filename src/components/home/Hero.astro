---
/* Hero + top nav. Port of the v3 prototype `du` component (section#top). */
import LucideIcon from "./LucideIcon.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { siteContact } from "@/data/site-contact";
import { homeProfile } from "@/data/home-profile";

const wa = siteContact.whatsappCta;
const benefits = ["מאפיון ועד מוצר", "פתרון מותאם לצורך", "צוות מפתחים", "CTO במיקור חוץ"];
const navLinks = [
  { label: "מי אני", href: "#about", active: true },
  { label: "מה אני בונה", href: "#services" },
  { label: "דוגמה", href: "#example" },
  { label: "איך מתחילים", href: "#contact" },
];
const rotating = ["למציאות.", "למערכת.", "לפיצ'ר."];
---

<section
  id="top"
  dir="rtl"
  class="ah-hero relative isolate flex min-h-[100dvh] w-full flex-col overflow-hidden bg-background font-sans text-foreground"
>
  <div class="ah-grid" aria-hidden="true"></div>
  <div class="ah-floor" aria-hidden="true"></div>
  <div class="ah-blob ah-blob-g" aria-hidden="true"></div>
  <div class="ah-blob ah-blob-o" aria-hidden="true"></div>
  <div class="ah-spot" aria-hidden="true"></div>
  <div class="ah-noise" aria-hidden="true"></div>

  <nav
    class="relative z-10 mx-auto mt-[18px] flex w-[min(1240px,calc(100%-32px))] items-center justify-between gap-4 rounded-[18px] border border-border bg-card/55 py-2.5 pl-3 pr-5 backdrop-blur-xl"
    aria-label="ניווט ראשי"
  >
    <a href="/" dir="ltr" class="flex items-center gap-2.5 text-lg font-extrabold">
      <span class="ah-logo-mark"><span>🤝</span></span>
      <span>Hand<b class="text-[hsl(var(--primary-text))]">In</b>Hand<i class="not-italic text-accent">AI</i></span>
    </a>
    <div class="hidden gap-7 text-[15px] font-medium text-muted-foreground lg:flex">
      {navLinks.map((l) => (
        <a
          href={l.href}
          data-navlink={l.href.slice(1)}
          class:list={[
            "ah-navlink relative transition-colors hover:text-foreground",
            l.active && "is-active text-foreground",
          ]}
        >
          {l.label}
        </a>
      ))}
    </div>
    <a
      href={wa}
      target="_blank"
      rel="noopener noreferrer"
      class="ah-btn ah-btn-primary !rounded-xl !px-[18px] !py-2.5 !text-[15px]"
    >
      <WhatsAppIcon class="h-[18px] w-[18px]" />
      <span class="hidden sm:inline">בואו נדבר</span>
    </a>
  </nav>

  <div
    class="ah-main mx-auto grid w-[min(1240px,calc(100%-32px))] flex-1 items-center gap-[clamp(24px,4vw,64px)] py-[clamp(28px,5vh,64px)] lg:grid-cols-[1.05fr_1fr]"
  >
    <div class="relative z-[2] text-center lg:text-right">
      <ul class="ah-benefits" aria-label="מה מקבלים">
        {benefits.map((b) => (
          <li>
            <span class="ah-benefit-ic"><LucideIcon name="check" class="h-3 w-3" strokeWidth={3} /></span>
            {b}
          </li>
        ))}
      </ul>

      <h1 class="ah-h1 mt-[22px] text-[clamp(2.3rem,4.9vw,4.7rem)] font-black leading-[1.08] tracking-[-0.02em]">
        <span class="ah-line"><span>אני <span class="ah-name">{homeProfile.firstName}</span>,</span></span>
        <span class="ah-line"><span>אני כאן כדי להפוך</span></span>
        <span class="ah-line">
          <span>
            רעיון{" "}
            <span class="ah-rot" aria-live="polite" data-rotator>
              {rotating.map((w, i) => (
                <span class={i === 0 ? "ah-rot-w is-on" : "ah-rot-w"} aria-hidden={i !== 0}>
                  {w}
                  <svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M3 12 C 60 5, 130 5, 197 11"></path>
                  </svg>
                </span>
              ))}
            </span>
          </span>
        </span>
      </h1>

      <div class="mt-[34px] flex flex-wrap justify-center gap-3.5 lg:justify-start">
        <a href={wa} target="_blank" rel="noopener noreferrer" class="ah-btn ah-btn-primary">
          <WhatsAppIcon class="h-[18px] w-[18px]" />
          בואו נדבר
        </a>
        <a href="#services" class="ah-btn ah-btn-ghost group">
          מה אפשר לבנות{" "}
          <LucideIcon name="arrow-left" class="h-[18px] w-[18px] transition-transform group-hover:-translate-x-1.5" />
        </a>
      </div>

      <div class="mt-[18px] flex items-center justify-center gap-2 text-sm text-muted-foreground lg:justify-start">
        <span class="grid h-[18px] w-[18px] place-items-center rounded-full bg-primary text-primary-foreground">
          <LucideIcon name="check" class="h-3 w-3" strokeWidth={3} />
        </span>
        שיחת אבחון ראשונה — בלי התחייבות
      </div>
    </div>

    <div
      class="ah-visual relative -order-1 aspect-[1/1.05] w-[min(100%,440px)] justify-self-center lg:order-none lg:w-[min(100%,560px)]"
    >
      <div class="ah-tilt absolute inset-0">
        <div class="ah-ring ah-ring-2"><span class="ah-sat"></span></div>
        <div class="ah-ring ah-ring-1"><span class="ah-sat"></span></div>
        <div class="ah-orb"></div>
        <div class="ah-portrait">
          <img
            src="/home/alex-hero.webp"
            alt={homeProfile.firstName}
            width="490"
            height="930"
            fetchpriority="high"
            class="block h-full w-full object-contain object-bottom"
          />
        </div>
        <div class="ah-badge" aria-hidden="true">
          <svg class="ah-badge-txt" viewBox="0 0 120 120">
            <defs>
              <path id="ah-circ" d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0"></path>
            </defs>
            <text>
              <textPath href="#ah-circ" textLength="286" lengthAdjust="spacing">IDEA → CODE → GROWTH • LET'S BUILD •</textPath>
            </text>
          </svg>
          <span class="ah-badge-core"><LucideIcon name="code-xml" class="h-[45%] w-[45%]" strokeWidth={2.4} /></span>
        </div>
        <div class="ah-chip ah-chip-1">
          <span class="ah-chip-ic bg-primary/15 text-[hsl(var(--primary-text))]"><LucideIcon name="layers" class="h-[18px] w-[18px]" /></span>
          <span>CTO במיקור חוץ<small>ליווי טכנולוגי צמוד</small></span>
        </div>
        <div class="ah-chip ah-chip-2">
          <span class="ah-chip-ic bg-accent/15 text-accent"><LucideIcon name="zap" class="h-[18px] w-[18px]" /></span>
          <span>מרעיון ועד ביצוע<small>מקצה לקצה</small></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.getElementById("top");
  if (hero) {
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty("--mx", `${e.clientX - r.left}px`);
      hero.style.setProperty("--my", `${e.clientY - r.top}px`);
    });
  }

  /* Rotating last word of the headline. */
  const rot = document.querySelector<HTMLElement>("[data-rotator]");
  if (rot && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const words = Array.from(rot.querySelectorAll<HTMLElement>(".ah-rot-w"));
    let i = 0;
    window.setInterval(() => {
      i = (i + 1) % words.length;
      words.forEach((w, k) => {
        w.classList.toggle("is-on", k === i);
        w.setAttribute("aria-hidden", k === i ? "false" : "true");
      });
    }, 2600);
  }
</script>
