---
/* Shared homepage document (v3 — "Alex" personal-brand site). Rendered by `/` and `/en`
   (identical Hebrew content; canonical always points to `/`).
   Spec: docs/specs/homepage-v3/. Order follows the prototype render order.
   The <html> chrome shared with every other page in this design system lives
   in HomeDocumentShell.astro (issue #82) — this file is now a thin caller of it. */
import HomeDocumentShell from "./HomeDocumentShell.astro";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import WhyAlex from "./WhyAlex.astro";
import About from "./About.astro";
import CaseStudies from "./CaseStudies.astro";
import WhyToggle from "./WhyToggle.astro";
import Contact from "./Contact.astro";
import { homeProfile } from "@/data/home-profile";
import { buildOrganizationSchema } from "@/data/organization-schema";

const title = "אלכס — HandInHandAI: סוכני AI ומערכות ניהול לעסקים";
const description =
  "אני אלכס, הופך רעיון למציאות: סוכני AI, מערכות ניהול ואפליקציות מותאמות אישית לעסקים, ושותף טכנולוגי (CTO) למיזמים וסטארטאפים. שיחת אבחון ראשונה — בלי התחייבות.";
const ogDescription =
  "מערכות ניהול, אפליקציות, סוכני AI ואוטומציות שנבנים סביב העסק שלכם — עם שותף טכנולוגי שחושב ביזנס.";
const site = Astro.site ?? new URL("https://handinhandai.com");
const canonical = new URL("/", site).href;
const ogImage = new URL("/og/home/og.jpg", site).href;

const jsonLd = {
  ...buildOrganizationSchema(site.toString()),
  image: ogImage,
  slogan: "אני כאן כדי להפוך רעיון למציאות",
  description:
    "פיתוח מערכות ניהול, אפליקציות וטכנולוגיה לעסקים (Custom CRM, סוכני AI, אוטומציות) ושותפות טכנולוגית / CTO למיזמים וסטארטאפים.",
  areaServed: { "@type": "Country", name: "Israel" },
  availableLanguage: "he",
  founder: { "@type": "Person", name: homeProfile.firstName, jobTitle: "מייסד, מפתח ו-CTO במיקור חוץ" },
  knowsAbout: ["מערכות ניהול לעסקים", "פיתוח אפליקציות לאנדרואיד ול-iOS", "פיתוח אפליקציות", "Custom CRM", "סוכני AI", "אוטומציה לעסקים", "CTO במיקור חוץ", "פיתוח MVP"],
};
---

<HomeDocumentShell
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogDescription={ogDescription}
  jsonLd={jsonLd}
>
  <link slot="head-extra" rel="preload" as="image" href="/home/alex-hero.webp" />
  <Hero />
  <Services />
  <WhyAlex />
  <About />
  <CaseStudies />
  <WhyToggle />
  <Contact />
</HomeDocumentShell>
