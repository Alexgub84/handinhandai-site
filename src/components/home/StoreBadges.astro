---
/* "Available on the App Store / Google Play" badges for a case card whose product
   ships as a mobile app. Drawn inline (no store asset downloads, no external
   requests) and labelled in Hebrew, matching the card's own type scale. */
import type { CaseStore } from "@/data/case-studies";

interface Props {
  stores: CaseStore[];
  class?: string;
}

const { stores, class: className } = Astro.props;

const LABELS: Record<CaseStore, { top: string; name: string }> = {
  appstore: { top: "זמין ב", name: "App Store" },
  googleplay: { top: "זמין ב", name: "Google Play" },
};
---

<ul class:list={["sb", className]} aria-label="חנויות האפליקציות">
  {stores.map((s) => (
    <li class="sb-badge">
      {s === "appstore" ? (
        <svg viewBox="0 0 24 24" aria-hidden="true" class="sb-ic">
          <path
            fill="currentColor"
            d="M16.37 12.76c.02-2.18 1.78-3.23 1.86-3.28-1.02-1.49-2.6-1.69-3.16-1.71-1.34-.14-2.62.79-3.3.79-.68 0-1.73-.77-2.85-.75-1.46.02-2.81.85-3.56 2.16-1.52 2.63-.39 6.53 1.09 8.66.72 1.05 1.58 2.22 2.71 2.18 1.09-.04 1.5-.7 2.82-.7 1.31 0 1.69.7 2.84.68 1.17-.02 1.92-1.06 2.64-2.11.83-1.21 1.17-2.39 1.19-2.45-.03-.01-2.28-.88-2.3-3.47zM14.2 5.9c.6-.73 1-1.74.89-2.75-.86.04-1.9.57-2.52 1.29-.55.64-1.03 1.67-.9 2.65.96.08 1.94-.49 2.53-1.19z"
          ></path>
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" aria-hidden="true" class="sb-ic">
          <path fill="currentColor" d="M3.6 2.4c-.25.26-.4.67-.4 1.2v16.8c0 .53.15.94.4 1.2l.09.08 9.4-9.4v-.22l-9.4-9.4-.09.08z"></path>
          <path fill="currentColor" opacity="0.78" d="M16.2 15.4l-3.11-3.12v-.22l3.12-3.12.07.04 3.7 2.1c1.06.6 1.06 1.58 0 2.18l-3.7 2.1-.08.04z"></path>
          <path fill="currentColor" opacity="0.6" d="M16.28 15.36L13.09 12.17 3.6 21.6c.35.37.92.42 1.57.05l11.11-6.29z"></path>
          <path fill="currentColor" opacity="0.9" d="M16.28 8.64L5.17 2.35C4.52 1.98 3.95 2.03 3.6 2.4l9.49 9.43 3.19-3.19z"></path>
        </svg>
      )}
      <span class="sb-txt">
        <small>{LABELS[s].top}</small>
        <b>{LABELS[s].name}</b>
      </span>
    </li>
  ))}
</ul>
