---
import { type Lang } from '@i18n/ui';
import { useTranslations, getLocalizedPath } from '@i18n/utils';
import LanguageSwitcher from '@components/LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2">
        <img src="/logo.png" alt="Hand in Hand AI" class="h-8 w-8" />
        <span class="text-xl font-bold text-blue-600">{t('site.title')}</span>
      </a>

      <nav class="hidden md:flex items-center gap-6">
        <a
          href={getLocalizedPath('/', lang)}
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          {t('nav.home')}
        </a>
        <!-- Hidden for now
        <a
          href={getLocalizedPath('/about', lang)}
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          {t('nav.about')}
        </a>
        <a
          href={getLocalizedPath('/services', lang)}
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          {t('nav.services')}
        </a>
        -->
        <a
          href={getLocalizedPath('/fitness-studio', lang)}
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          {t('nav.fitnessStudio')}
        </a>
        <a
          href={getLocalizedPath('/fitness-chain', lang)}
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          {t('nav.fitnessChain')}
        </a>
        <a
          href="https://wa.me/972545053620"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          {t('nav.contact')}
        </a>
      </nav>

      <div class="flex items-center gap-4">
        <LanguageSwitcher lang={lang} />
        
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open menu</span>
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-gray-200 bg-white">
    <nav class="px-4 py-4 space-y-2">
      <a
        href={getLocalizedPath('/', lang)}
        class="block px-4 py-3 text-base font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-colors"
      >
        {t('nav.home')}
      </a>
      <!-- Hidden for now
      <a
        href={getLocalizedPath('/about', lang)}
        class="block px-4 py-3 text-base font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-colors"
      >
        {t('nav.about')}
      </a>
      <a
        href={getLocalizedPath('/services', lang)}
        class="block px-4 py-3 text-base font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-colors"
      >
        {t('nav.services')}
      </a>
      -->
      <a
        href={getLocalizedPath('/fitness-studio', lang)}
        class="block px-4 py-3 text-base font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-colors"
      >
        {t('nav.fitnessStudio')}
      </a>
      <a
        href={getLocalizedPath('/fitness-chain', lang)}
        class="block px-4 py-3 text-base font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-colors"
      >
        {t('nav.fitnessChain')}
      </a>
      <a
        href="https://wa.me/972545053620"
        target="_blank"
        rel="noopener noreferrer"
        class="block px-4 py-3 text-base font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-colors"
      >
        {t('nav.contact')}
      </a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    
    menuButton.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    menuIconOpen?.classList.toggle('hidden');
    menuIconClose?.classList.toggle('hidden');
  });

  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
    });
  });
</script>
