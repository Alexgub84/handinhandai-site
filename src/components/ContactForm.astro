---
import { type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const webhookUrl = import.meta.env.PUBLIC_WEBHOOK_URL;
---

<div id="contact-form-wrapper" data-webhook-url={webhookUrl} data-other-value={t('contact.companyTypeOther')}>
  <form id="contact-form" class="bg-white p-6 sm:p-8 md:p-10 rounded-2xl shadow-lg border border-gray-100" novalidate>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      <div>
        <label for="firstName" class="block text-sm font-medium text-gray-700 mb-2">
          {t('contact.firstName')} <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="firstName"
          name="first_name"
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-gray-900 placeholder-gray-400"
          data-error-message={t('contact.error.firstName')}
        />
        <p class="error-message mt-1 text-sm text-red-600 hidden"></p>
      </div>

      <div>
        <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">
          {t('contact.lastName')} <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="lastName"
          name="last_name"
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-gray-900 placeholder-gray-400"
          data-error-message={t('contact.error.lastName')}
        />
        <p class="error-message mt-1 text-sm text-red-600 hidden"></p>
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
          {t('contact.email')} <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-gray-900 placeholder-gray-400"
          data-error-message={t('contact.error.email')}
        />
        <p class="error-message mt-1 text-sm text-red-600 hidden"></p>
      </div>

      <div>
        <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
          {t('contact.phone')} <span class="text-red-500">*</span>
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-gray-900 placeholder-gray-400"
          data-error-message={t('contact.error.phone')}
        />
        <p class="error-message mt-1 text-sm text-red-600 hidden"></p>
      </div>

      <div class="sm:col-span-2">
        <label for="companyType" class="block text-sm font-medium text-gray-700 mb-2">
          {t('contact.companyType')} <span class="text-red-500">*</span>
        </label>
        <select
          id="companyType"
          name="company_type"
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-gray-900 bg-white"
          data-error-message={t('contact.error.companyType')}
        >
          <option value="">{t('contact.companyTypePlaceholder')}</option>
          <option value={t('contact.companyTypeLawFirm')}>{t('contact.companyTypeLawFirm')}</option>
          <option value={t('contact.companyTypeAccounting')}>{t('contact.companyTypeAccounting')}</option>
          <option value={t('contact.companyTypeHealthcare')}>{t('contact.companyTypeHealthcare')}</option>
          <option value={t('contact.companyTypeRealEstate')}>{t('contact.companyTypeRealEstate')}</option>
          <option value={t('contact.companyTypeEcommerce')}>{t('contact.companyTypeEcommerce')}</option>
          <option value={t('contact.companyTypeManufacturing')}>{t('contact.companyTypeManufacturing')}</option>
          <option value={t('contact.companyTypeFinancial')}>{t('contact.companyTypeFinancial')}</option>
          <option value={t('contact.companyTypeOther')}>{t('contact.companyTypeOther')}</option>
        </select>
        <p class="error-message mt-1 text-sm text-red-600 hidden"></p>
      </div>

      <div id="companyTypeOtherWrapper" class="sm:col-span-2 hidden">
        <label for="companyTypeOther" class="block text-sm font-medium text-gray-700 mb-2">
          {t('contact.companyTypeOtherPlaceholder')} <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="companyTypeOther"
          name="company_type_other"
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-gray-900 placeholder-gray-400"
          data-error-message={t('contact.error.companyTypeOther')}
        />
        <p class="error-message mt-1 text-sm text-red-600 hidden"></p>
      </div>

      <div class="sm:col-span-2">
        <label for="service" class="block text-sm font-medium text-gray-700 mb-2">
          {t('contact.service')} <span class="text-red-500">*</span>
        </label>
        <select
          id="service"
          name="service_needed"
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-gray-900 bg-white"
          data-error-message={t('contact.error.service')}
        >
          <option value="">{t('contact.servicePlaceholder')}</option>
          <option value={t('contact.serviceConsulting')}>{t('contact.serviceConsulting')}</option>
          <option value={t('contact.serviceAutomation')}>{t('contact.serviceAutomation')}</option>
          <option value={t('contact.serviceChatbot')}>{t('contact.serviceChatbot')}</option>
          <option value={t('contact.serviceCustom')}>{t('contact.serviceCustom')}</option>
          <option value={t('contact.serviceOther')}>{t('contact.serviceOther')}</option>
        </select>
        <p class="error-message mt-1 text-sm text-red-600 hidden"></p>
      </div>
    </div>

    <div class="mt-6 sm:mt-8">
      <button
        type="submit"
        id="submit-button"
        class="w-full px-6 py-3.5 sm:py-4 text-base sm:text-lg font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 active:bg-blue-800 transition-colors shadow-lg hover:shadow-xl touch-manipulation cursor-pointer disabled:bg-blue-400 disabled:cursor-not-allowed"
      >
        <span id="submit-text">{t('contact.submit')}</span>
        <span id="submit-loading" class="hidden">{t('contact.sending')}</span>
      </button>
    </div>
  </form>

  <div id="success-message" class="hidden bg-white p-8 sm:p-10 md:p-12 rounded-2xl shadow-lg border border-gray-100 text-center">
    <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">
      {t('contact.success.title')}
    </h3>
    <p class="text-base sm:text-lg text-gray-600">
      {t('contact.success.message')}
    </p>
  </div>

  <div id="error-message" class="hidden bg-white p-8 sm:p-10 md:p-12 rounded-2xl shadow-lg border border-red-200 text-center">
    <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </div>
    <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">
      {lang === 'he' ? 'אנחנו מצטערים' : "We're Sorry"}
    </h3>
    <p class="text-base sm:text-lg text-gray-600">
      {lang === 'he' ? 'משהו השתבש. אנחנו נתקן את זה בהקדם האפשרי.' : "Something went wrong. We'll fix it as soon as possible."}
    </p>
    <p id="error-details" class="mt-2 text-sm text-gray-500 hidden"></p>
    <button
      id="try-again-button"
      class="mt-6 px-6 py-3 text-base font-semibold text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors"
    >
      {lang === 'he' ? 'נסו שוב' : 'Try Again'}
    </button>
  </div>
</div>

<script>
  const wrapper = document.getElementById('contact-form-wrapper');
  const WEBHOOK_URL = wrapper?.dataset.webhookUrl || '';
  const OTHER_VALUE = wrapper?.dataset.otherValue || 'אחר';
  const LOG_ERROR_URL = '/api/log-error';

  async function logErrorToServer(errorInfo: {
    message: string;
    stack?: string;
    status?: number;
    statusText?: string;
    formData?: Record<string, unknown>;
  }) {
    try {
      await fetch(LOG_ERROR_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...errorInfo,
          url: window.location.href,
          timestamp: new Date().toISOString(),
          userAgent: navigator.userAgent,
        }),
      });
    } catch (logErr) {
      console.error('Failed to log error to server:', logErr);
    }
  }
  
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');
  const errorDetails = document.getElementById('error-details');
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text');
  const submitLoading = document.getElementById('submit-loading');
  const tryAgainButton = document.getElementById('try-again-button');
  const companyTypeSelect = document.getElementById('companyType') as HTMLSelectElement | null;
  const companyTypeOtherWrapper = document.getElementById('companyTypeOtherWrapper');
  const companyTypeOtherInput = document.getElementById('companyTypeOther') as HTMLInputElement | null;

  function toggleCompanyTypeOther() {
    if (!companyTypeSelect) return;
    const isOther = companyTypeSelect.value === OTHER_VALUE;
    companyTypeOtherWrapper?.classList.toggle('hidden', !isOther);
    if (isOther) {
      companyTypeOtherInput?.setAttribute('required', 'required');
    } else {
      companyTypeOtherInput?.removeAttribute('required');
      if (companyTypeOtherInput) {
        companyTypeOtherInput.value = '';
        clearError(companyTypeOtherInput);
      }
    }
  }

  companyTypeSelect?.addEventListener('change', toggleCompanyTypeOther);
  
  function validateEmail(email: string): boolean {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
  }

  function showError(input: HTMLInputElement | HTMLSelectElement, message: string) {
    input.classList.add('border-red-500');
    input.classList.remove('border-gray-300');
    const errorElement = input.parentElement?.querySelector('.error-message');
    if (errorElement) {
      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
    }
  }

  function clearError(input: HTMLInputElement | HTMLSelectElement) {
    input.classList.remove('border-red-500');
    input.classList.add('border-gray-300');
    const errorElement = input.parentElement?.querySelector('.error-message');
    if (errorElement) {
      errorElement.textContent = '';
      errorElement.classList.add('hidden');
    }
  }

  function validateField(input: HTMLInputElement | HTMLSelectElement): boolean {
    const value = input.value.trim();
    const errorMessage = input.dataset.errorMessage || 'This field is required';

    // Skip validation for non-required fields that are empty
    if (!input.required && !value) {
      clearError(input);
      return true;
    }

    if (input.type === 'email') {
      if (!value || !validateEmail(value)) {
        showError(input, errorMessage);
        return false;
      }
    } else if (!value) {
      showError(input, errorMessage);
      return false;
    }

    clearError(input);
    return true;
  }

  function setLoading(loading: boolean) {
    submitButton.disabled = loading;
    submitText?.classList.toggle('hidden', loading);
    submitLoading?.classList.toggle('hidden', !loading);
  }

  function showSuccessState() {
    form.classList.add('hidden');
    errorMessage?.classList.add('hidden');
    successMessage?.classList.remove('hidden');
  }

  function showErrorState(details?: string) {
    form.classList.add('hidden');
    successMessage?.classList.add('hidden');
    errorMessage?.classList.remove('hidden');
    if (errorDetails) {
      if (details) {
        errorDetails.textContent = details;
        errorDetails.classList.remove('hidden');
      } else {
        errorDetails.textContent = '';
        errorDetails.classList.add('hidden');
      }
    }
  }

  function resetForm() {
    form.reset();
    errorMessage?.classList.add('hidden');
    successMessage?.classList.add('hidden');
    form.classList.remove('hidden');
    companyTypeOtherWrapper?.classList.add('hidden');
    companyTypeOtherInput?.removeAttribute('required');
    if (errorDetails) {
      errorDetails.textContent = '';
      errorDetails.classList.add('hidden');
    }
  }

  const inputs = form.querySelectorAll('input, select');
  inputs.forEach((input) => {
    input.addEventListener('blur', () => {
      validateField(input as HTMLInputElement | HTMLSelectElement);
    });

    input.addEventListener('input', () => {
      const inputEl = input as HTMLInputElement | HTMLSelectElement;
      if (inputEl.classList.contains('border-red-500')) {
        validateField(inputEl);
      }
    });
  });

  tryAgainButton?.addEventListener('click', resetForm);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    let isValid = true;
    
    inputs.forEach((input) => {
      if (!validateField(input as HTMLInputElement | HTMLSelectElement)) {
        isValid = false;
      }
    });

    if (!isValid) return;

    setLoading(true);

    const formData = new FormData(form);
    const companyType = formData.get('company_type');
    const companyTypeOther = formData.get('company_type_other');
    const data = {
      first_name: formData.get('first_name'),
      last_name: formData.get('last_name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      company_type: companyType === OTHER_VALUE && companyTypeOther ? companyTypeOther : companyType,
      service_needed: formData.get('service_needed'),
      submitted_at: new Date().toISOString(),
      source_url: window.location.href,
    };

    try {
      const response = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        showSuccessState();
      } else {
        const responseText = await response.text().catch(() => 'Could not read response body');
        await logErrorToServer({
          message: `Webhook returned non-OK status: ${response.status} ${response.statusText}`,
          status: response.status,
          statusText: response.statusText + ' - Body: ' + responseText,
          formData: data,
        });
        showErrorState(`Server error: ${response.status}`);
      }
    } catch (error) {
      const err = error as Error;
      await logErrorToServer({
        message: err.message || 'Unknown error during form submission',
        stack: err.stack,
        formData: data,
      });
      console.error('Form submission error:', error);
      const userMessage = err.message?.includes('fetch') || err.message?.includes('network')
        ? 'Network error - please check your connection'
        : 'Connection error - please try again';
      showErrorState(userMessage);
    } finally {
      setLoading(false);
    }
  });
</script>
