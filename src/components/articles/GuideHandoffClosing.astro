---
/**
 * The end-of-guide sign-off block (work order `guide-service-and-route`,
 * manager Ruling 2, 2026-11-23). Mounted unconditionally on every non-draft
 * article, right after the existing `.art-cta` WhatsApp block and before
 * the sibling-articles nav — introduces Alex in his own voice and points at
 * `/#example`. Ported verbatim from the approved specimen
 * `local/design/guide-blocks-v1/components/guide-blocks.html`'s "Block C"
 * (`.art-about`), copy variant C2 from
 * `local/design/guide-blocks-copy-v2-2026-11-23.md`, word for word — gives
 * a reason to look at the examples (verify the claim) and a reason to
 * write (the reader's own problem sounds like this one).
 *
 * Two states, driven by whether the article carries a `skill` (the
 * hand-off card), never by a new frontmatter field:
 * - `compact` (the hand-off card already showed a WhatsApp button and the
 *   AI-answers-first disclosure a few centimetres above): eyebrow + own-
 *   voice paragraph + examples link only — no `.ah-btn`, no `AiAnswersNote`.
 * - full (no hand-off card above it, so this is the only place left to
 *   write to Alex from): adds the WhatsApp button and the disclosure.
 *
 * `AiAnswersNote` is imported, never re-typed as prose. All `data-track`
 * labels are computed from the slug, never hand-typed per guide:
 * `guide-about-examples-${slug}`, `guide-about-whatsapp-${slug}`,
 * `guide-about-home-${slug}`. The root element carries
 * `data-track-section="about-alex"` so reach can be told from clicks, the
 * same contract `SkillHandoff.astro` already follows.
 *
 * Work order `guide-funnel-fix` (Alex, 2026-11-27, no issue): a plain link
 * to the home page itself (`/`, not `/#example`) sits next to the existing
 * examples link. Only 4 of 181 visits that begin on a guide ever reach the
 * home page, where almost every contact click happens — this adds a second,
 * plainer way there for a reader not drawn to "לראות מה בניתי". Reuses
 * `.art-about-link` verbatim — no new class, no new component.
 */
import WhatsAppIcon from "@components/home/WhatsAppIcon.astro";
import AiAnswersNote from "@components/home/AiAnswersNote.astro";
import { waLink } from "@/data/site-contact";

interface Props {
  slug: string;
  compact: boolean;
}

const { slug, compact } = Astro.props;

const examplesTrack = `guide-about-examples-${slug}`;
const whatsappTrack = `guide-about-whatsapp-${slug}`;
const homeTrack = `guide-about-home-${slug}`;
const whatsappHref = waLink();
---

<div class="art-about" data-track-section="about-alex">
  <span class="skill-handoff-eyebrow"><span class="dot"></span>מי בנה את זה</span>
  <p class="art-about-text">
    אני אלכס. בניתי את מה שכתוב כאן מתוך עבודה אמיתית — מערכות לעסקים,
    ו־<span class="lat">CTO</span> לסטארטאפ — לא מתוך תיאוריה. בעמוד הבית
    יש דוגמאות אמיתיות לאיך זה נראה כשזה עובד; מי שרוצה לראות את זה ולא רק
    לקרוא עליו, זה המקום. ואם הבעיה שלכם נשמעת דומה למה שכתוב כאן, כתבו לי.
  </p>
  <div class="art-about-actions">
    <a href="/#example" class="art-about-link" data-track={examplesTrack}>לראות מה בניתי</a>
    <a href="/" class="art-about-link" data-track={homeTrack}>לדף הבית</a>
    {!compact && (
      <a
        href={whatsappHref}
        class="ah-btn ah-btn-ghost"
        target="_blank"
        rel="noopener noreferrer"
        data-track={whatsappTrack}
      >
        <WhatsAppIcon />
        <span>לכתוב לי בוואטסאפ</span>
      </a>
    )}
  </div>
  {!compact && <AiAnswersNote class="art-about-note" />}
</div>
