---
/* H2: איך זה עובד, צעד אחר צעד — 7 numbered steps, copy verbatim from the
   spec. The numbered-badge list itself is the generic NumberedList.astro
   (issue #82 round 2). */
import NumberedList from "@/components/home/NumberedList.astro";

const steps = [
  "ממלאים את הטופס ומעלים את הקבצים (5 דקות).",
  "תוך יום עסקים: דוח מוכנות. ירוק או רשימת תיקונים.",
  "משלמים, חותמים דיגיטלית.",
  "גוגל: אנחנו מעלים ומגישים. אפל: אתם מזמינים אותנו לחשבון, אנחנו בונים ומגישים.",
  "בדיקה של החנות: 1 עד 7 ימים. דחייה? תקבלו הסבר בעברית ומה לעשות.",
  "באוויר. שולחים לכם קישורים.",
  "עדכונים דרך אותו טופס.",
];
const items = steps.map((text) => ({ text }));
---

<section id="steps" dir="rtl" class="pg-section">
  <div class="pg-wrap">
    <h2 class="pg-h2">איך זה עובד, צעד אחר צעד</h2>
    <NumberedList items={items} />
  </div>
</section>
