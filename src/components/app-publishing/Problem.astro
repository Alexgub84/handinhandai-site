---
/* H2: הבעיה שאתם מכירים — copy verbatim from the spec. The two-card grid is
   scoped here (not in the shared app-publishing.css) — specific to this
   section's content, not a primitive (issue #82 round 2, design §A5). */
import LucideIcon from "@/components/home/LucideIcon.astro";
---

<section id="problem" dir="rtl" class="pg-section">
  <div class="pg-wrap">
    <h2 class="pg-h2">הבעיה שאתם מכירים</h2>
    <div class="ap-problem-grid">
      <div class="ap-problem-card">
        <h3><LucideIcon name="triangle-alert" class="h-[18px] w-[18px]" /> גוגל פליי</h3>
        <p>
          חשבון מפתח פרטי חדש חייב להריץ בדיקה סגורה עם 12 טסטרים במשך 14 יום רצופים לכל אפליקציה, ורק אז לבקש
          גישה לייצור. טסטר אחד שמוחק את האפליקציה ביום העשירי מאפס את הספירה. אחר כך שאלון, ולפעמים דחייה וסיבוב
          נוסף.
        </p>
      </div>
      <div class="ap-problem-card">
        <h3><LucideIcon name="triangle-alert" class="h-[18px] w-[18px]" /> אפ סטור</h3>
        <p>
          אין טסטרים, אבל יש Xcode שרץ רק על מק, סרטיפיקטים, Provisioning Profiles, TestFlight, תוויות פרטיות,
          ו-App Review שדוחה את רוב ההגשות הראשונות על סעיפים שלא ידעתם שקיימים.
        </p>
      </div>
    </div>
    <p class="ap-problem-closer">וזה עוד לפני העדכון הראשון.</p>
  </div>
</section>

<style>
  .ap-problem-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .ap-problem-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ap-problem-card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 20px 40px -32px hsl(var(--shadow) / var(--shadow-a));
  }
  .ap-problem-card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 800;
    color: hsl(var(--foreground));
    margin: 0 0 10px;
  }
  .ap-problem-card h3 svg {
    color: hsl(var(--destructive));
    flex: none;
  }
  .ap-problem-card p {
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
    margin: 0;
  }
  .ap-problem-closer {
    margin-top: 20px;
    font-weight: 700;
    color: hsl(var(--foreground));
  }
</style>
