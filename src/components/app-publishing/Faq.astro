---
/* H2: שאלות נפוצות — rendered from src/data/app-publishing.ts's `faq` array
   (also the source for the FAQPage JSON-LD built in src/pages/app-publishing.astro).
   The accordion itself is the generic FaqList.astro (issue #82 round 2). */
import FaqList from "@/components/home/FaqList.astro";
import { faq } from "@/data/app-publishing";
---

<section id="faq" dir="rtl" class="pg-section">
  <div class="pg-wrap">
    <h2 class="pg-h2">שאלות נפוצות</h2>
    <FaqList entries={faq} />
  </div>
</section>
